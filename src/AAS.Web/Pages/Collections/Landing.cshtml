@page "/Collections/Landing"
@using AAS.Web.Models
@using AAS.Web.Data
@using AAS.Web.Resources
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Collections"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Get category counts
    var categoryCounts = await Db.Collections
        .GroupBy(c => c.Category)
        .Select(g => new { Category = g.Key, Count = g.Count() })
        .ToDictionaryAsync(x => x.Category, x => x.Count);
    
    // Get featured images for each category
    var categoryImages = new Dictionary<CollectionCategory, string?>();
    foreach (CollectionCategory cat in Enum.GetValues(typeof(CollectionCategory)))
    {
        var featuredImage = await Db.Collections
            .Where(c => c.Category == cat)
            .SelectMany(c => c.Images.OrderBy(i => i.SortOrder).Take(1))
            .Select(i => i.FileName)
            .FirstOrDefaultAsync();
        categoryImages[cat] = featuredImage;
    }
    
    // Get preview items for each category (up to 3 items per category)
    var categoryPreviews = new Dictionary<CollectionCategory, List<Collection>>();
    foreach (CollectionCategory cat in Enum.GetValues(typeof(CollectionCategory)))
    {
        var previews = await Db.Collections
            .Include(c => c.Images)
            .Where(c => c.Category == cat)
            .OrderByDescending(c => c.CreatedUtc)
            .Take(3)
            .ToListAsync();
        categoryPreviews[cat] = previews;
    }
    
    var categories = new[] {
        new { Cat = CollectionCategory.Paintings, Icon = "bi-palette", Key = "Paintings" },
        new { Cat = CollectionCategory.Jewelry, Icon = "bi-gem", Key = "Jewelry" },
        new { Cat = CollectionCategory.Watches, Icon = "bi-stopwatch", Key = "Watches" },
        new { Cat = CollectionCategory.Statues, Icon = "bi-person-bounding-box", Key = "Statues" },
        new { Cat = CollectionCategory.GoldSilver, Icon = "bi-coin", Key = "GoldSilver" },
        new { Cat = CollectionCategory.Other, Icon = "bi-stars", Key = "DecorativeArtsOther" }
    };
}

<div class="collections-landing">
    <!-- Hero Section -->
    <section class="landing-hero" style="display: flex; justify-content: center; align-items: center; width: 100%;">
        <div style="width: 100%; display: flex; justify-content: center; align-items: center;">
            <div class="hero-content" style="text-align: center; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 900px;">
                <img src="/images/logo-hero.png" alt="Aristocratic Artwork Sale" class="animate-fade-in" style="max-width: 300px; max-height: 240px; width: auto; height: auto; margin-bottom: 1.5rem; filter: drop-shadow(0 0 25px rgba(212, 175, 55, 0.3));" />
                <p class="text-accent text-gold mb-4 animate-fade-in delay-1">@L["Explore collections"]</p>
                <h1 class="hero-title animate-fade-in delay-2">@L["Collections"]</h1>
                <div class="hero-divider animate-fade-in delay-3"></div>
                <p class="hero-subtitle animate-fade-in delay-3">@L["Home Description"]</p>
            </div>
        </div>
    </section>

    <!-- Categories Grid -->
    <section class="categories-section">
        <div class="container">
            <div class="section-header text-center">
                <p class="text-accent text-gold mb-3">@L["Browse"]</p>
                <h2 class="section-title">@L["Explore collections"]</h2>
                <p class="section-subtitle">@L["Collections Description"]</p>
            </div>
            
            <div class="categories-grid">
                @foreach (var cat in categories)
                {
                    var count = categoryCounts.ContainsKey(cat.Cat) ? categoryCounts[cat.Cat] : 0;
                    var image = categoryImages.ContainsKey(cat.Cat) ? categoryImages[cat.Cat] : null;
                    
                    <a href="/Collections?category=@cat.Cat" class="category-card" data-testid="category-@cat.Cat.ToString().ToLower()">
                        <div class="category-image-wrapper">
                            @if (!string.IsNullOrEmpty(image))
                            {
                                <img src="/uploads/images/@(image)-960.jpg" 
                                     alt="@L[cat.Key]" 
                                     class="category-image"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="category-placeholder">
                                    <i class="bi @cat.Icon"></i>
                                </div>
                            }
                            <div class="category-overlay"></div>
                        </div>
                        <div class="category-content">
                            <div class="category-icon">
                                <i class="bi @cat.Icon"></i>
                            </div>
                            <h3 class="category-title">@L[cat.Key]</h3>
                            <p class="category-count">
                                @if (count > 0)
                                {
                                    <span>@count @(count == 1 ? L["item"] : L["items"])</span>
                                }
                                else
                                {
                                    <span class="text-gold">@L["Discover"]</span>
                                }
                            </p>
                            <span class="category-cta">
                                @L["Explore"] <i class="bi bi-arrow-right ms-2"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Featured Items Preview Section -->
    @{
        var hasAnyItems = categoryPreviews.Any(cp => cp.Value.Any());
    }
    @if (hasAnyItems)
    {
    <section class="section section-dark">
        <div class="container">
            <div class="text-center mb-5 reveal">
                <p class="text-accent text-gold mb-3">@L["Featured"]</p>
                <h2 style="font-size: var(--text-4xl);">@L["Latest Additions"]</h2>
                <p class="text-muted mt-3" style="max-width: 600px; margin: 0 auto;">
                    @L["Explore our newest acquisitions from each category"]
                </p>
            </div>
            
            @foreach (var cat in categories)
            {
                var previews = categoryPreviews.ContainsKey(cat.Cat) ? categoryPreviews[cat.Cat] : new List<Collection>();
                if (previews.Any())
                {
                    <div class="category-preview-section mb-5 reveal">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="mb-0">
                                <i class="bi @cat.Icon text-gold me-2"></i>
                                @L[cat.Key]
                            </h3>
                            <a href="/Collections?category=@cat.Cat" class="btn btn-sm btn-outline-secondary">
                                @L["View All"] <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                        
                        <div class="row g-4">
                            @foreach (var item in previews)
                            {
                                var firstImage = item.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
                                <div class="col-md-6 col-lg-4">
                                    <a href="/Collections/Details/@item.Slug" class="preview-card" data-testid="preview-item-@item.Id">
                                        <div class="preview-card-image">
                                            @if (firstImage != null)
                                            {
                                                <img src="/uploads/images/@(firstImage.FileName)-480.jpg" 
                                                     alt="@item.Title" 
                                                     loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="preview-placeholder">
                                                    <i class="bi @cat.Icon"></i>
                                                </div>
                                            }
                                            @if (item.Status == CollectionStatus.Sold)
                                            {
                                                <span class="preview-badge sold">@L["Sold"]</span>
                                            }
                                            else if (item.AASVerified)
                                            {
                                                <span class="preview-badge verified">
                                                    <i class="bi bi-patch-check-fill me-1"></i>@L["Verified"]
                                                </span>
                                            }
                                        </div>
                                        <div class="preview-card-content">
                                            <h4 class="preview-title">@item.Title</h4>
                                            @if (item.Status == CollectionStatus.Available && !string.IsNullOrEmpty(item.Price))
                                            {
                                                <p class="preview-price">
                                                    @{
                                                        if (decimal.TryParse(item.Price, out decimal priceValue))
                                                        {
                                                            if (item.Currency == Currency.EUR)
                                                            {
                                                                @string.Format("{0:N0} €", priceValue)
                                                            }
                                                            else
                                                            {
                                                                @string.Format("$ {0:N0}", priceValue)
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @item.Price
                                                        }
                                                    }
                                                </p>
                                            }
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </section>
    }

    <!-- Info Section -->
    <section class="info-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <div class="info-content">
                        <p class="text-accent text-gold mb-3">@L["Excellence in Every Transaction"]</p>
                        <h2 class="info-title">@L["Why Choose Us"]</h2>
                        <p class="info-text">@L["BuyOrSellDetails"]</p>
                        
                        <div class="info-features">
                            <div class="info-feature">
                                <i class="bi bi-shield-check"></i>
                                <span>@L["Complete Discretion"]</span>
                            </div>
                            <div class="info-feature">
                                <i class="bi bi-award"></i>
                                <span>@L["Expert Service"]</span>
                            </div>
                            <div class="info-feature">
                                <i class="bi bi-cash-stack"></i>
                                <span>@L["Highest Prices"]</span>
                            </div>
                        </div>
                        
                        <div class="info-actions">
                            <a href="/HowTo" class="btn btn-primary">
                                <i class="bi bi-arrow-right me-2"></i>@L["LearnMore"]
                            </a>
                            <a href="/Contacts" class="btn btn-outline-secondary">
                                <i class="bi bi-envelope me-2"></i>@L["Contact Us"]
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="aas-badge-showcase">
                        <div class="aas-badge-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <h3>@L["WhatIsAASVerified"]</h3>
                        <p>@L["AASVerifiedExplanation"]</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Background Music: Vltava by Bedřich Smetana -->
<div id="musicControl" class="music-control" style="display: none;">
    <button id="musicToggle" class="music-toggle" title="Toggle Music">
        <i class="bi bi-music-note-beamed"></i>
    </button>
</div>

<audio id="backgroundMusic" loop preload="auto">
    <source src="https://upload.wikimedia.org/wikipedia/commons/6/61/Vltava_%28The_Moldau%29.ogg" type="audio/ogg">
</audio>

<style>
.music-control {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 1000;
}

.music-toggle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
    border: 2px solid var(--color-gold);
    color: var(--color-gold);
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
}

.music-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
}

.music-toggle.playing {
    animation: pulse-gold 2s infinite;
}

.music-toggle.paused {
    opacity: 0.7;
}

@@keyframes pulse-gold {
    0%, 100% { box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3); }
    50% { box-shadow: 0 4px 25px rgba(212, 175, 55, 0.6); }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const audio = document.getElementById('backgroundMusic');
    const control = document.getElementById('musicControl');
    const toggle = document.getElementById('musicToggle');
    
    // Check if user came from clicking "Explore collections" (has referrer from home page)
    const fromExplore = sessionStorage.getItem('playMusic') === 'true' || 
                        document.referrer.includes('/Home') || 
                        document.referrer.endsWith('/') ||
                        document.referrer === '';
    
    // Show music control
    control.style.display = 'block';
    
    // Try to play music automatically if user came from explore button
    if (fromExplore) {
        // Set flag for future page loads within session
        sessionStorage.setItem('playMusic', 'true');
        
        // Attempt to play (may be blocked by browser autoplay policy)
        const playPromise = audio.play();
        
        if (playPromise !== undefined) {
            playPromise.then(() => {
                // Autoplay started
                toggle.classList.add('playing');
                toggle.innerHTML = '<i class="bi bi-pause-fill"></i>';
            }).catch(() => {
                // Autoplay was prevented - show play button
                toggle.classList.add('paused');
                toggle.innerHTML = '<i class="bi bi-play-fill"></i>';
            });
        }
    } else {
        toggle.classList.add('paused');
        toggle.innerHTML = '<i class="bi bi-play-fill"></i>';
    }
    
    // Toggle music on button click
    toggle.addEventListener('click', function() {
        if (audio.paused) {
            audio.play();
            toggle.classList.remove('paused');
            toggle.classList.add('playing');
            toggle.innerHTML = '<i class="bi bi-pause-fill"></i>';
            sessionStorage.setItem('playMusic', 'true');
        } else {
            audio.pause();
            toggle.classList.remove('playing');
            toggle.classList.add('paused');
            toggle.innerHTML = '<i class="bi bi-play-fill"></i>';
            sessionStorage.setItem('playMusic', 'false');
        }
    });
    
    // Update button state when audio ends (shouldn't happen with loop, but just in case)
    audio.addEventListener('ended', function() {
        toggle.classList.remove('playing');
        toggle.classList.add('paused');
        toggle.innerHTML = '<i class="bi bi-play-fill"></i>';
    });
});
</script>
