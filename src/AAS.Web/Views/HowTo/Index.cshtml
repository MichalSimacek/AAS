@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["HowToBuySell"];
}

<!-- Hero Section -->
<section class="hero" style="min-height: 50vh; padding: 80px 0;">
  <div class="hero-content">
    <p class="text-accent text-gold mb-3 animate-fade-in">@L["Guide"]</p>
    <h1 class="hero-title animate-fade-in delay-1" style="font-size: var(--text-5xl);">@L["HowToBuySell"]</h1>
    <div class="hero-divider animate-fade-in delay-2"></div>
    <p class="hero-subtitle animate-fade-in delay-3">
      @L["HowToBuySellDescription"]
    </p>
  </div>
</section>

<!-- Buy & Sell Sections -->
<section class="section">
  <div class="container">
    <div class="row g-5">
      
      <!-- How to Buy -->
      <div class="col-lg-6 reveal-left">
        <div class="gradient-border p-4 p-lg-5 h-100">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="step-indicator animate-glow">
              <i class="bi bi-cart-check" style="font-size: 28px;"></i>
            </div>
            <h2 style="font-size: var(--text-3xl); margin: 0;">@L["HowToBuy"]</h2>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">1</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToBuyStep1Title"]</h4>
            <p class="text-muted">@L["HowToBuyStep1Text"]</p>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">2</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToBuyStep2Title"]</h4>
            <p class="text-muted">@L["HowToBuyStep2Text"]</p>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">3</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToBuyStep3Title"]</h4>
            <p class="text-muted">@L["HowToBuyStep3Text"]</p>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">4</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToBuyStep4Title"]</h4>
            <p class="text-muted">@L["HowToBuyStep4Text"]</p>
          </div>
          
          <div class="mt-4 p-3" style="background: rgba(34, 197, 94, 0.1); border-radius: var(--radius-md); border: 1px solid rgba(34, 197, 94, 0.2);">
            <p class="text-muted small mb-0">
              <i class="bi bi-info-circle me-2" style="color: #22c55e;"></i>
              <strong>@L["Note"]:</strong> @L["HowToBuyNote"]
            </p>
          </div>
        </div>
      </div>
      
      <!-- How to Sell -->
      <div class="col-lg-6 reveal-right">
        <div class="gradient-border p-4 p-lg-5 h-100">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="step-indicator animate-glow">
              <i class="bi bi-currency-dollar" style="font-size: 28px;"></i>
            </div>
            <h2 style="font-size: var(--text-3xl); margin: 0;">@L["HowToSell"]</h2>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">1</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToSellStep1Title"]</h4>
            <p class="text-muted mb-2">@L["HowToSellStep1Text"]</p>
            <p class="mb-0">
              <a href="mailto:info@aristocraticartworksale.com" class="text-gold">
                <i class="bi bi-envelope me-2"></i>info@aristocraticartworksale.com
              </a>
            </p>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">2</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToSellStep2Title"]</h4>
            <p class="text-muted">@L["HowToSellStep2Text"]</p>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">3</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToSellStep3Title"]</h4>
            <p class="text-muted">@L["HowToSellStep3Text"]</p>
          </div>
          
          <div class="howto-step">
            <div class="step-number">
              <div class="step-indicator" style="width: 50px; height: 50px; font-size: var(--text-lg);">4</div>
            </div>
            <h4 class="mb-2 text-gold">@L["HowToSellStep4Title"]</h4>
            <p class="text-muted">@L["HowToSellStep4Text"]</p>
          </div>
          
          <div class="mt-4 p-3" style="background: rgba(234, 179, 8, 0.1); border-radius: var(--radius-md); border: 1px solid rgba(234, 179, 8, 0.2);">
            <p class="text-muted small mb-0">
              <i class="bi bi-exclamation-triangle me-2" style="color: #eab308;"></i>
              <strong>@L["Note"]:</strong> @L["HowToSellNote"]
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AAS Verified Section -->
<section class="section section-dark">
  <div class="container">
    <div class="text-center mb-5 reveal">
      <div class="mb-4">
        <div class="step-indicator mx-auto animate-glow" style="width: 100px; height: 100px;">
          <i class="bi bi-patch-check-fill" style="font-size: 48px;"></i>
        </div>
      </div>
      <p class="text-accent text-gold mb-3">@L["Authentication"]</p>
      <h2 style="font-size: var(--text-4xl);">@L["WhatIsAASVerified"]</h2>
      <p class="lead text-muted mt-3" style="max-width: 700px; margin: 0 auto;">
        @L["AASVerifiedExplanation"]
      </p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-6 reveal-left">
        <div class="feature-card h-100" style="border-left: 4px solid #22c55e;">
          <div class="d-flex align-items-center gap-3 mb-3">
            <i class="bi bi-patch-check-fill text-gold" style="font-size: 32px;"></i>
            <h4 class="mb-0">@L["WithAASVerified"]</h4>
          </div>
          <p class="text-muted mb-0">@L["WithAASVerifiedText"]</p>
        </div>
      </div>
      
      <div class="col-md-6 reveal-right">
        <div class="feature-card h-100" style="border-left: 4px solid var(--color-text-dim);">
          <div class="d-flex align-items-center gap-3 mb-3">
            <i class="bi bi-question-circle text-muted" style="font-size: 32px;"></i>
            <h4 class="mb-0">@L["WithoutAASVerified"]</h4>
          </div>
          <p class="text-muted mb-0">@L["WithoutAASVerifiedText"]</p>
        </div>
      </div>
    </div>
    
    <p class="text-center text-muted mt-5 reveal">@L["AASVerifiedDisclaimer"]</p>
  </div>
</section>

<!-- CTA Section -->
<section class="section">
  <div class="container">
    <div class="text-center reveal">
      <p class="text-accent text-gold mb-3">@L["Ready to Start?"]</p>
      <h2 style="font-size: var(--text-3xl); margin-bottom: 2rem;">@L["Begin Your Journey Today"]</h2>
      
      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/Collections/Landing" class="btn btn-primary btn-lg">
          <i class="bi bi-search me-2"></i>@L["BrowseCollections"]
        </a>
        <a href="/Contacts" class="btn btn-outline-secondary btn-lg">
          <i class="bi bi-envelope me-2"></i>@L["ContactUs"]
        </a>
      </div>
    </div>
  </div>
</section>
