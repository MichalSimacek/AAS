@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@inject IConfiguration Cfg
@{
    var rqf = Context.Request.HttpContext.Features.Get<IRequestCultureFeature>();
    var culture = rqf?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    var cultures = new[]{"en","cs","ru","de","es","fr","zh","pt","hi","ja"};

    // Map ISO 2-letter -> BCP-47 region tags expected by hreflang & og:locale
    var bcp47 = new Dictionary<string,string>{
        {"en","en"}, {"cs","cs-CZ"}, {"ru","ru-RU"}, {"de","de-DE"},
        {"es","es-ES"}, {"fr","fr-FR"}, {"zh","zh-CN"}, {"pt","pt-PT"},
        {"hi","hi-IN"}, {"ja","ja-JP"}
    };
    string LocaleTag(string c) => bcp47.TryGetValue(c, out var v) ? v.Replace('-', '_') : c;
    var primaryLocale = LocaleTag(culture);

    var scheme = Context.Request.Scheme;
    var host = Context.Request.Host.Value;
    var path = Context.Request.Path.Value ?? "/";
    var qsCol = Context.Request.Query;

    // Variant C URL strategy — split the path into (cultureSegment, basePath):
    //  - /                                  → cultureSegment="",  basePath="/"
    //  - /Collections/Landing               → cultureSegment="",  basePath="/Collections/Landing"
    //  - /ru/Collections/Landing            → cultureSegment="ru", basePath="/Collections/Landing"
    //  - /ru/Collections/Details/foo        → cultureSegment="ru", basePath="/Collections/Details/foo"
    var nonDefaultCultures = new HashSet<string>(new[] { "cs", "ru", "de", "es", "fr", "zh", "pt", "hi", "ja" });
    string cultureSegment = "";
    string basePath = path;
    {
        var firstSeg = path.TrimStart('/').Split('/', 2)[0];
        if (nonDefaultCultures.Contains(firstSeg))
        {
            cultureSegment = firstSeg;
            basePath = path.Length > firstSeg.Length + 1 ? path.Substring(firstSeg.Length + 1) : "/";
        }
    }
    string PathFor(string c)
    {
        var seg = (c == "en") ? "" : $"/{c}";
        if (basePath == "/" || string.IsNullOrEmpty(basePath))
            return seg == "" ? "/" : seg;
        return seg + basePath;
    }

    // Pages where every query string is a filter/sort/pager — canonical should
    // collapse to the bare path so Google does not treat each filter combination
    // as a duplicate URL.
    var stripAllParamsForCanonical =
        basePath.Equals("/Collections", StringComparison.OrdinalIgnoreCase) ||
        basePath.Equals("/Blog", StringComparison.OrdinalIgnoreCase);

    var canonicalQuery = stripAllParamsForCanonical
        ? string.Empty
        : string.Join("&",
            qsCol.Where(q => q.Key != "culture" && q.Key != "ui-culture")
                 .Select(q => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(q.Value.ToString())}"));
    var canonical = $"{scheme}://{host}{path}" + (string.IsNullOrEmpty(canonicalQuery) ? "" : "?" + canonicalQuery);
    string AltUrl(string c) => $"{scheme}://{host}{PathFor(c)}" +
        (string.IsNullOrEmpty(canonicalQuery) ? "" : "?" + canonicalQuery);

    // Add noindex,follow to filtered/paginated views and to invalid culture combos
    // so Google focuses crawl budget on the canonical pages.
    var isFilteredView = stripAllParamsForCanonical && qsCol.Any(q => q.Key != "culture" && q.Key != "ui-culture");

    // Per-page title + description with sensible localized defaults
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Aristocratic Artwork Sale"
        : $"{pageTitle} | Aristocratic Artwork Sale";
    var defaultDesc = L["Slogan"].Value;
    var pageDesc = (ViewData["Description"] as string) ?? defaultDesc;
    if (pageDesc.Length > 300) pageDesc = pageDesc.Substring(0, 297) + "...";

    var googleSiteVerification = Cfg["Seo:GoogleSiteVerification"];
    var bingSiteVerification = Cfg["Seo:BingSiteVerification"];

    // Current culture prefix for in-app navigation links.
    // EN (default) → empty; others → "/{culture}" (e.g. "/ru")
    var cp = culture == "en" ? "" : $"/{culture}";
}
<!DOCTYPE html>
<html lang="@culture">
