@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Http
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    var rqf = Context.Request.HttpContext.Features.Get<IRequestCultureFeature>();
    var culture = rqf?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    var cultures = new[]{"en","cs","ru","de","es","fr","zh","pt","hi","ja"};
}
<!DOCTYPE html>
<html lang="@culture">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Aristocratic Artwork Sale</title>
  <meta name="description" content="Discretion, quality and professionalism in fine art, jewelry, watches and collectibles." />
  @RenderSection("Meta", required: false)
  
  <!-- Google Analytics - ONLY loaded after user consent (GDPR compliant) -->
  <script>
    // Initialize dataLayer for future GA usage
    window.dataLayer = window.dataLayer || [];
    window.gaLoaded = false;
    
    // This function will be called after user gives consent
    window.loadGoogleAnalytics = function() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;
      
      // Define gtag function
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      
      // Set consent to granted
      gtag('consent', 'default', {
        'ad_storage': 'granted',
        'analytics_storage': 'granted',
        'personalization_storage': 'denied',
        'functionality_storage': 'granted',
        'security_storage': 'granted'
      });
      
      // Load GA script dynamically
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-KCCM6EVFFL';
      script.onload = function() {
        gtag('js', new Date());
        gtag('config', 'G-KCCM6EVFFL', {
          'anonymize_ip': true,
          'allow_ad_personalization_signals': false,
          'allow_google_signals': false
        });
        console.log('Google Analytics loaded after consent');
      };
      document.head.appendChild(script);
    };
  </script>
  <style>
    /* Critical CSS to prevent FOUC and layout shifts */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { font-size: 16px; height: 100%; }
    body {
      background: #FFFFFF;
      color: #1A1A1A;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      visibility: visible;
      opacity: 1;
      transition: none;
    }
    main { flex: 1 0 auto; width: 100%; contain: layout style; }
    .container { max-width: 1140px; margin: 0 auto; padding: 0 15px; width: 100%; }
    .identity-card { max-width: 520px; width: 100%; margin: 0 auto; padding: 48px; }
  </style>
  <!-- Google Fonts - loaded only after consent to comply with GDPR -->
  <!-- Using Inter for both headings and body - elegant and highly readable -->
  <style>
    :root {
      --font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }
    body, h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-primary);
    }
  </style>
  <script>
    // Load Google Fonts only after consent
    window.loadGoogleFonts = function() {
      if (window.fontsLoaded) return;
      window.fontsLoaded = true;
      
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap';
      document.head.appendChild(link);
      console.log('Google Fonts loaded after consent');
    };
  </script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/site.css?v=43-cookie-popup" />
  <link rel="icon" href="/images/logo.png"/>
  <meta property="og:title" content="Aristocratic Artwork Sale"/>
  <meta property="og:type" content="website"/>
  <meta property="og:image" content="/images/logo.png"/>
  <meta property="og:description" content="@L["Slogan"]"/>
  <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" integrity="sha384-gAPqlBuTCdtVcYt9ocMOYWrnBZ4XSL6q+4eXqwNycOr4iFczhNKtnYhF3NEXJM51" crossorigin="anonymous" />
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "Organization",
    "name": "Aristocratic Artwork Sale",
    "url": "https://aristocraticartworksale.com",
    "logo": "/images/logo.png"
  }
  </script>
  @RenderSection("Styles", required: false)
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg container">
      <button class="navbar-toggler mx-auto" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div id="nav" class="collapse navbar-collapse justify-content-center">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/">@L["Home"]</a></li>
          <li class="nav-item"><a class="nav-link" href="/Collections">@L["Collections"]</a></li>
          <li class="nav-item"><a class="nav-link" href="/Blog">@L["Blog"]</a></li>
          <li class="nav-item"><a class="nav-link" href="/About">@L["About us"]</a></li>
          <li class="nav-item"><a class="nav-link" href="/Contacts">@L["Contacts"]</a></li>
          <partial name="_LoginPartial" />
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
              @culture.ToUpper()
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              @foreach (var c in cultures){
                <li><a class="dropdown-item" href="#" onclick="setLang('@c')">@c.ToUpper()</a></li>
              }
            </ul>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <main>@RenderBody()</main>

  <!-- Background Music Player -->
  <audio id="background-music" loop preload="auto">
    <source src="/audio/tchaikovsky-swan-lake.mp3" type="audio/mpeg">
  </audio>
  
  <!-- Music Control Button (Fixed position) -->
  <button id="music-toggle" class="music-toggle-btn" title="Toggle Music" aria-label="Toggle background music">
    <i class="bi bi-music-note-beamed" id="music-icon"></i>
  </button>
  
  <footer>
    <div class="container text-center">
      <p class="mb-2"><strong>@L["Site Name"]</strong></p>
      <p class="small mb-0">@string.Format(L["Footer rights text"], DateTime.UtcNow.Year)</p>
    </div>
  </footer>

  <!-- JS Libraries with SRI -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" integrity="sha384-6a2U1/Wfbqbt5InHJGJZH3B0HJ2r7KV5wJ8OQJh9I8ZZ8wZbFGZFrKzCeCjQX1Pm" crossorigin="anonymous"></script>
  <script src="/js/site.js?v=5"></script>

  <form id="cultureForm" method="post" asp-area="" asp-controller="Home" asp-action="SetLanguage">
    <input type="hidden" name="culture" id="cultureInput" />
    <input type="hidden" name="returnUrl" id="returnUrlInput" />
  </form>
  
  <script>
  function setLang(culture) {
    document.getElementById('cultureInput').value = culture;
    document.getElementById('returnUrlInput').value = window.location.pathname + window.location.search;
    document.getElementById('cultureForm').submit();
  }
  </script>

  <!-- GDPR Cookie Consent Banner -->
  <div id="cookie-consent-banner" class="cookie-consent-banner" style="display: none; position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; background: rgba(0, 0, 0, 0.8) !important; z-index: 9999 !important; align-items: center !important; justify-content: center !important; padding: 20px !important;">
    <div class="cookie-consent-content" style="background: white !important; border-radius: 16px !important; padding: 40px !important; max-width: 700px !important; width: 100% !important; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3) !important; text-align: center !important; position: relative !important; animation: popupSlideIn 0.4s ease-out !important;">
      
      <!-- Main Cookie Consent View -->
      <div id="cookie-main-view">
        <div class="cookie-consent-text">
          <h4>🍪 @L["Cookie Settings"]</h4>
          <p>
            @L["We use cookies and similar technologies to improve your browsing experience, analyze website traffic, and understand where our visitors are coming from. By clicking 'Accept All', you consent to our use of cookies."]
          </p>
          <p class="cookie-links">
            <a href="https://www.google.com/policies/privacy/partners/" target="_blank">@L["How Google uses data"]</a> |
            <a href="/Home/Privacy" target="_blank">@L["Privacy Policy"]</a>
          </p>
        </div>
        <div class="cookie-consent-buttons">
          <button id="cookie-decline" class="btn btn-outline-secondary">@L["Decline"]</button>
          <button id="cookie-settings" class="btn btn-outline-primary">@L["Settings"]</button>
          <button id="cookie-accept" class="btn btn-primary">@L["Accept All"]</button>
        </div>
      </div>

      <!-- Settings View (initially hidden) -->
      <div id="cookie-settings-view" style="display: none;">
        <h5 style="color: #1A1A1A; margin-bottom: 30px; font-size: 28px; font-weight: 700; font-family: 'Playfair Display', serif;">@L["Cookie Preferences"]</h5>
        
        <div class="cookie-category">
          <div class="cookie-toggle">
            <label class="form-check-label">
              <strong>@L["Essential Cookies"]</strong>
              <input type="checkbox" checked disabled>
              <span class="checkmark essential"></span>
            </label>
          </div>
          <p class="cookie-description">@L["These cookies are necessary for the website to function and cannot be switched off."]</p>
        </div>

        <div class="cookie-category">
          <div class="cookie-toggle">
            <label class="form-check-label">
              <strong>@L["Analytics Cookies"]</strong>
              <input type="checkbox" id="analytics-toggle">
              <span class="checkmark"></span>
            </label>
          </div>
          <p class="cookie-description">@L["These cookies help us understand how visitors interact with our website by collecting and reporting information anonymously."]</p>
        </div>

        <div class="cookie-category">
          <div class="cookie-toggle">
            <label class="form-check-label">
              <strong>@L["Marketing Cookies"]</strong>
              <input type="checkbox" id="marketing-toggle">
              <span class="checkmark"></span>
            </label>
          </div>
          <p class="cookie-description">@L["These cookies are used to make advertising messages more relevant to you and your interests."]</p>
        </div>

        <div class="cookie-settings-buttons">
          <button id="settings-back" class="btn btn-secondary">← @L["Back"]</button>
          <button id="settings-save" class="btn btn-primary">@L["Save Preferences"]</button>
        </div>
      </div>
    </div>

    <!-- Remove the separate modal - no longer needed -->
  </div>

  <!-- Cookie Consent JavaScript -->
  <script>
    (function() {
      const COOKIE_CONSENT_KEY = 'aas_cookie_consent';
      const CONSENT_EXPIRY_DAYS = 365;
      
      // Check if consent already given
      const savedConsent = getCookie(COOKIE_CONSENT_KEY);
      if (!savedConsent) {
        showCookieBanner();
      } else {
        // Apply saved consent settings
        const consent = JSON.parse(savedConsent);
        applyConsentSettings(consent);
      }

      // Event listeners
      document.getElementById('cookie-accept').addEventListener('click', function() {
        console.log('Accept All clicked');
        acceptAllCookies();
      });

      document.getElementById('cookie-decline').addEventListener('click', function() {
        console.log('Decline clicked');
        declineAllCookies();
      });

      document.getElementById('cookie-settings').addEventListener('click', function() {
        console.log('Settings clicked');
        showSettingsView();
      });

      document.getElementById('settings-save').addEventListener('click', function() {
        console.log('Save preferences clicked');
        saveCustomSettings();
      });

      document.getElementById('settings-back').addEventListener('click', function() {
        console.log('Back clicked');
        showMainView();
      });

      // ESC key support
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          const banner = document.getElementById('cookie-consent-banner');
          const settingsView = document.getElementById('cookie-settings-view');
          
          if (banner && banner.style.display === 'flex') {
            // If in settings view, go back to main view
            if (settingsView && settingsView.style.display === 'block') {
              showMainView();
            }
            // Note: Don't close entire banner on ESC - user must make choice
          }
        }
      });

      // Remove old modal backdrop click handler since we no longer have separate modal
      // The main banner stays open until user makes a choice

      function showCookieBanner() {
        const banner = document.getElementById('cookie-consent-banner');
        banner.style.display = 'flex';
        // Ensure popup positioning
        banner.style.position = 'fixed';
        banner.style.top = '0';
        banner.style.left = '0';
        banner.style.right = '0';
        banner.style.bottom = '0';
        banner.style.zIndex = '9999';
        banner.style.backgroundColor = 'rgba(0, 0, 0, 0.8)';
        banner.style.alignItems = 'center';
        banner.style.justifyContent = 'center';
        
        // Focus trap for accessibility
        banner.focus();
        // Prevent background scrolling
        document.body.style.overflow = 'hidden';
        console.log('Cookie banner shown as popup overlay');
      }

      function hideCookieBanner() {
        const banner = document.getElementById('cookie-consent-banner');
        banner.style.display = 'none';
        document.body.style.overflow = '';
      }

      function showSettingsView() {
        document.getElementById('cookie-main-view').style.display = 'none';
        document.getElementById('cookie-settings-view').style.display = 'block';
        
        // Set current preferences in toggles
        const consent = getCookie(COOKIE_CONSENT_KEY);
        if (consent) {
          const parsed = JSON.parse(consent);
          document.getElementById('analytics-toggle').checked = parsed.analytics || false;
          document.getElementById('marketing-toggle').checked = parsed.marketing || false;
        }
        
        // Update popup width for settings content
        const content = document.querySelector('.cookie-consent-content');
        content.style.maxWidth = '700px';
        content.style.textAlign = 'left';
        console.log('Switched to settings view');
      }

      function showMainView() {
        document.getElementById('cookie-settings-view').style.display = 'none';
        document.getElementById('cookie-main-view').style.display = 'block';
        
        // Reset popup styling
        const content = document.querySelector('.cookie-consent-content');
        content.style.maxWidth = '600px';
        content.style.textAlign = 'center';
        console.log('Switched to main view');
      }

      function acceptAllCookies() {
        const consent = {
          analytics: true,
          marketing: true,
          essential: true,
          timestamp: new Date().toISOString()
        };
        
        saveConsent(consent);
        applyConsentSettings(consent);
        hideCookieBanner();
      }

      function declineAllCookies() {
        const consent = {
          analytics: false,
          marketing: false,
          essential: true, // Always required
          timestamp: new Date().toISOString()
        };
        
        saveConsent(consent);
        applyConsentSettings(consent);
        hideCookieBanner();
      }

      function saveCustomSettings() {
        const consent = {
          analytics: document.getElementById('analytics-toggle').checked,
          marketing: document.getElementById('marketing-toggle').checked,
          essential: true,
          timestamp: new Date().toISOString()
        };
        
        saveConsent(consent);
        applyConsentSettings(consent);
        hideCookieBanner();
        console.log('Custom settings saved:', consent);
      }

      function saveConsent(consent) {
        // URL-encode the JSON to handle special characters properly
        setCookie(COOKIE_CONSENT_KEY, encodeURIComponent(JSON.stringify(consent)), CONSENT_EXPIRY_DAYS);
      }

      function applyConsentSettings(consent) {
        // Load Google Analytics and Fonts only if user gave consent
        if (consent.analytics) {
          // Load GA
          if (typeof window.loadGoogleAnalytics === 'function') {
            window.loadGoogleAnalytics();
          }
          // Load Google Fonts (optional - only if analytics consent given)
          if (typeof window.loadGoogleFonts === 'function') {
            window.loadGoogleFonts();
          }
        }
        
        // Update GA consent state if already loaded
        if (typeof gtag !== 'undefined') {
          gtag('consent', 'update', {
            'analytics_storage': consent.analytics ? 'granted' : 'denied',
            'ad_storage': consent.marketing ? 'granted' : 'denied',
            'personalization_storage': consent.marketing ? 'granted' : 'denied',
            'functionality_storage': consent.analytics ? 'granted' : 'denied'
          });
        }
      }

      function setCookie(name, value, days) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        document.cookie = name + "=" + value + ";expires=" + date.toUTCString() + ";path=/;SameSite=Lax;Secure";
      }

      function getCookie(name) {
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
          let c = ca[i];
          while (c.charAt(0) === ' ') c = c.substring(1, c.length);
          if (c.indexOf(nameEQ) === 0) {
            // URL-decode the value
            try {
              return decodeURIComponent(c.substring(nameEQ.length, c.length));
            } catch(e) {
              return c.substring(nameEQ.length, c.length);
            }
          }
        }
        return null;
      }
    })();
  </script>
  
  @RenderSection("Scripts", required: false)
</body>
</html>
