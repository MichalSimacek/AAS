@model AAS.Web.Models.Collection
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@using System.Web
@{
  var images = Model.Images.OrderBy(i => i.SortOrder).ToList();
  var firstImage = images.FirstOrDefault();
  var imageUrl = firstImage != null ? $"{Context.Request.Scheme}://{Context.Request.Host}/uploads/images/{firstImage.FileName}-1600.jpg" : "";
  var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
  var displayTitle = (ViewBag.TranslatedTitle as string) ?? Model.Title;
  var displayDescription = (ViewBag.TranslatedDescription as string) ?? Model.Description ?? "";
  var description = !string.IsNullOrEmpty(displayDescription) && displayDescription.Length > 160
    ? displayDescription.Substring(0, 160) + "..."
    : (string.IsNullOrEmpty(displayDescription) ? "Aristocratic Artwork Sale" : displayDescription);

  ViewData["Title"] = displayTitle;
  ViewData["Description"] = description;

  // JSON-LD Product schema mapping
  string availability = Model.Status switch {
      AAS.Web.Models.CollectionStatus.Available => "https://schema.org/InStock",
      AAS.Web.Models.CollectionStatus.Sold      => "https://schema.org/SoldOut",
      AAS.Web.Models.CollectionStatus.InAuction => "https://schema.org/PreOrder",
      _ => "https://schema.org/InStock"
  };
  string currencyCode = Model.Currency == AAS.Web.Models.Currency.USD ? "USD" : "EUR";
  bool hasNumericPrice = decimal.TryParse(Model.Price, System.Globalization.NumberStyles.Any,
                          System.Globalization.CultureInfo.InvariantCulture, out var numericPrice);
  var allImageUrls = images
      .Select(i => $"{Context.Request.Scheme}://{Context.Request.Host}/uploads/images/{i.FileName}-1600.jpg")
      .ToList();
}

@section Meta {
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="product" />
  <meta property="og:url" content="@pageUrl" />
  <meta property="og:title" content="@displayTitle - Aristocratic Artwork Sale" />
  <meta property="og:description" content="@description" />
  @if (!string.IsNullOrEmpty(imageUrl))
  {
    <meta property="og:image" content="@imageUrl" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="@displayTitle" />
  }
  @if (Model.Status == AAS.Web.Models.CollectionStatus.Available && hasNumericPrice)
  {
    <meta property="product:price:amount" content="@numericPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
    <meta property="product:price:currency" content="@currencyCode" />
    <meta property="product:availability" content="in stock" />
  }
  else if (Model.Status == AAS.Web.Models.CollectionStatus.Sold)
  {
    <meta property="product:availability" content="out of stock" />
  }

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="@pageUrl" />
  <meta name="twitter:title" content="@displayTitle - Aristocratic Artwork Sale" />
  <meta name="twitter:description" content="@description" />
  @if (!string.IsNullOrEmpty(imageUrl))
  {
    <meta name="twitter:image" content="@imageUrl" />
    <meta name="twitter:image:alt" content="@displayTitle" />
  }

  <!-- Schema.org Product -->
  <script type="application/ld+json">
  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
  {
      ["@context"] = "https://schema.org",
      ["@type"] = "Product",
      ["name"] = displayTitle,
      ["description"] = displayDescription,
      ["image"] = allImageUrls.Any() ? (object)allImageUrls : null,
      ["sku"] = $"AAS-{Model.Id}",
      ["category"] = Model.Category.ToString(),
      ["brand"] = new Dictionary<string, object> {
          ["@type"] = "Brand",
          ["name"] = "Aristocratic Artwork Sale"
      },
      ["offers"] = new Dictionary<string, object?> {
          ["@type"] = "Offer",
          ["url"] = pageUrl,
          ["priceCurrency"] = currencyCode,
          ["price"] = hasNumericPrice ? numericPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) : null,
          ["availability"] = availability,
          ["itemCondition"] = "https://schema.org/UsedCondition",
          ["seller"] = new Dictionary<string, object> {
              ["@type"] = "Organization",
              ["name"] = "Aristocratic Artwork Sale"
          }
      }
  }, new System.Text.Json.JsonSerializerOptions {
      DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
      Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
  }))
  </script>

  <!-- Schema.org BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "BreadcrumbList",
    "itemListElement": [
      { "@@type":"ListItem", "position":1, "name":"@L["Home"]", "item":"@($"{Context.Request.Scheme}://{Context.Request.Host}/")" },
      { "@@type":"ListItem", "position":2, "name":"@L["Collections"]", "item":"@($"{Context.Request.Scheme}://{Context.Request.Host}/Collections")" },
      { "@@type":"ListItem", "position":3, "name":"@displayTitle" }
    ]
  }
  </script>
}

<div class="section">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4 reveal">
      <ol class="breadcrumb" style="background: transparent; padding: 0; margin: 0;">
        <li class="breadcrumb-item"><a href="/" class="text-gold"><i class="bi bi-house me-1"></i>@L["Home"]</a></li>
        <li class="breadcrumb-item"><a href="/Collections" class="text-gold">@L["Collections"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@(ViewBag.TranslatedTitle as string ?? Model.Title)</li>
      </ol>
      
      @* Admin Edit Button *@
      @if (User.IsInRole("Admin"))
      {
        <a href="/Admin/Collections/Edit/@Model.Id" class="admin-edit-btn" title="@L["Edit Collection"]" data-testid="admin-edit-btn">
          <i class="bi bi-pencil-square"></i>
        </a>
      }
    </nav>

    <div class="row g-4">
      <div class="col-12 col-lg-7 reveal-left">
        <div class="detail-gallery-card gradient-border">
          <!-- Main Image Display -->
          <div class="main-image-container">
            @if(images.Any()){
              <img id="mainImage" 
                   class="main-gallery-image" 
                   alt="@displayTitle" 
                   src="/uploads/images/@images.First().FileName-960.jpg"
                   data-full="/uploads/images/@images.First().FileName-1600.jpg"
                   onclick="openLightbox(0)" />
            }
          </div>
          
          <!-- Instagram-style Thumbnail Grid -->
          @if(images.Count > 1){
            <div class="thumbnail-grid">
              @for(int i = 0; i < images.Count; i++){
                var img = images[i];
                <div class="thumbnail-item @(i == 0 ? "active" : "")" 
                     data-index="@i"
                     data-src="/uploads/images/@img.FileName-960.jpg"
                     data-full="/uploads/images/@img.FileName-1600.jpg"
                     onclick="selectThumbnail(this, @i)">
                  <img src="/uploads/images/@img.FileName-480.jpg" 
                       alt="@displayTitle - @(i+1)" />
                </div>
              }
            </div>
          }
          
          @* Price and Status display directly under photos *@
          <div class="detail-price-section">
            <div class="d-flex justify-content-between align-items-center">
              @if (Model.Status == AAS.Web.Models.CollectionStatus.Sold)
              {
                <div class="flex-grow-1">
                  <span class="badge detail-badge-sold">@L["Sold"]</span>
                </div>
              }
              else if (Model.Status == AAS.Web.Models.CollectionStatus.InAuction)
              {
                <div class="flex-grow-1">
                  <span class="badge detail-badge-auction">@L["InAuction"]</span>
                </div>
              }
              else if (Model.Status == AAS.Web.Models.CollectionStatus.Available)
              {
                @if (!string.IsNullOrWhiteSpace(Model.Price))
                {
                  <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                      <span class="badge detail-badge-available">@L["Available"]</span>
                    </div>
                    <div class="text-end">
                      <div class="text-muted small">@L["Available for"]</div>
                      <h4 class="mb-0 detail-price">
                        @{
                          // Try to parse as decimal for formatted display
                          if (decimal.TryParse(Model.Price, out decimal priceValue))
                          {
                            if (Model.Currency == AAS.Web.Models.Currency.EUR)
                            {
                              @string.Format("{0:N0} €", priceValue)
                            }
                            else
                            {
                              @string.Format("$ {0:N0}", priceValue)
                            }
                          }
                          else
                          {
                            // Display as text (e.g., "Price on request")
                            @Model.Price
                          }
                        }
                      </h4>
                    </div>
                  </div>
                }
                else
                {
                  <div class="flex-grow-1">
                    <span class="badge detail-badge-available">@L["Available"]</span>
                  </div>
                }
              }
            </div>
            
            @* I'm Interested button directly under price/status *@
            @if (Model.Status == AAS.Web.Models.CollectionStatus.Available)
            {
              <div class="mt-3">
                <button class="btn btn-primary w-100 btn-lg" onclick="openInquiryForm()" data-testid="inquiry-button">
                  <i class="bi bi-heart me-2"></i>@L["I'm interested"]
                </button>
              </div>
            }
            
            @* Social Share Section *@
            <div class="mt-4 detail-share-section">
              <h6 class="detail-section-title">@L["Share this collection"]</h6>
              <div class="social-share-buttons">
                <a href="#" onclick="shareOnFacebook(); return false;" class="social-btn social-facebook" title="Share on Facebook">
                  <i class="bi bi-facebook"></i>
                </a>
                <a href="#" onclick="shareOnTwitter(); return false;" class="social-btn social-twitter" title="Share on X (Twitter)">
                  <i class="bi bi-twitter-x"></i>
                </a>
                <a href="#" onclick="shareOnLinkedIn(); return false;" class="social-btn social-linkedin" title="Share on LinkedIn">
                  <i class="bi bi-linkedin"></i>
                </a>
                <a href="#" onclick="copyLinkToClipboard(); return false;" class="social-btn social-link" title="Copy link">
                  <i class="bi bi-link-45deg"></i>
                </a>
              </div>
              <small id="copyMessage" class="copy-success-message">
                <i class="bi bi-check-circle me-1"></i>@L["Link copied to clipboard!"]
              </small>
            </div>
            
            @* Comments Section - Directly Below Button *@
            <div class="mt-4 detail-comments-section">
              <h5 class="detail-section-title mb-3">@L["Comments"]</h5>
              
              @* Comment Form (only for logged in users) *@
              @if (User.Identity?.IsAuthenticated == true)
              {
                <div class="comment-form-container mb-3">
                  <form id="commentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="collectionId" value="@Model.Id" />
                    <div class="mb-2">
                      <textarea class="form-control" id="commentText" name="text" rows="3" maxlength="2000" required placeholder="@L["Write your comment..."]"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">
                      <i class="bi bi-send me-1"></i>@L["Submit Comment"]
                    </button>
                  </form>
                </div>
              }
              else
              {
                <div class="comment-login-notice mb-3">
                  <i class="bi bi-lock me-2 text-gold"></i>
                  <a href="/Identity/Account/Login?returnUrl=@HttpUtility.UrlEncode(Context.Request.Path)" class="text-gold">@L["Sign in"]</a> @L["to leave a comment"]
                </div>
              }
              
              @* Comments List *@
              <div id="commentsList">
                <div class="text-center py-3">
                  <div class="spinner-border spinner-border-sm text-gold" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        @if(!string.IsNullOrEmpty(Model.AudioPath)){
          <div class="detail-audio-card">
            <h5><i class="bi bi-music-note-beamed text-gold me-2"></i>@L["Audio Description"]</h5>
            <audio controls class="w-100" src="@Model.AudioPath"></audio>
          </div>
        }
      </div>
      
      <div class="col-12 col-lg-5 reveal-right">
        <div class="detail-info-card gradient-border">
          <div class="detail-info-content">
            <span class="badge badge-gold mb-3">@L[Model.Category.ToString()]</span>
            
            @* AAS Verified Badge *@
            @if (Model.AASVerified)
            {
              <div class="aas-verified-badge mb-3">
                <img src="~/images/aas-verified-badge.svg" alt="AAS Verified" />
                <div>
                  <strong class="text-gold">@L["AASVerified"]</strong><br/>
                  <small class="text-muted">@L["AASVerifiedTooltip"]</small>
                </div>
              </div>
            }
            
            <h1 class="detail-title">@Html.Raw(Html.Encode(ViewBag.TranslatedTitle as string ?? Model.Title))</h1>
            
            <div class="detail-description">
              @{
                var descText = (ViewBag.TranslatedDescription as string ?? Model.Description ?? "").Trim();
                // Remove leading whitespace from each line
                var lines = descText.Split('\n').Select(line => line.TrimStart());
                var cleanedDesc = string.Join("<br/>", lines.Select(l => Html.Encode(l)));
              }
              @Html.Raw(cleanedDesc)
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Enhanced Lightbox with Zoom -->
<div id="lightboxModal" class="lightbox-modal" style="display: none;">
  <div class="lightbox-overlay" onclick="closeLightbox()"></div>
  
  <!-- Close button -->
  <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Close">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  
  <!-- Navigation arrows -->
  <button type="button" class="lightbox-nav lightbox-prev" onclick="lightboxPrev()" aria-label="Previous">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button type="button" class="lightbox-nav lightbox-next" onclick="lightboxNext()" aria-label="Next">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
  
  <!-- Image container with zoom -->
  <div class="lightbox-content">
    <div class="lightbox-image-wrapper" id="lightboxImageWrapper">
      <img id="lightboxImage" src="" alt="@Model.Title" class="lightbox-image" />
    </div>
    
    <!-- Zoom controls -->
    <div class="lightbox-controls">
      <button type="button" class="lightbox-control-btn" onclick="lightboxZoomOut()" title="Zoom out">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <span id="zoomLevel" class="zoom-level">100%</span>
      <button type="button" class="lightbox-control-btn" onclick="lightboxZoomIn()" title="Zoom in">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <button type="button" class="lightbox-control-btn" onclick="lightboxReset()" title="Reset zoom">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>
    </div>
    
    <!-- Counter -->
    <div class="lightbox-counter">
      <span id="lightboxCounter">1 / @images.Count</span>
    </div>
  </div>
</div>

<div id="interestModal" class="detail-modal">
  <div class="detail-modal-content">
    <div class="detail-modal-header">
      <h5><i class="bi bi-heart text-gold me-2"></i>@L["Send inquiry"]</h5>
      <button type="button" onclick="closeInquiryForm()" class="detail-modal-close">&times;</button>
    </div>
    <div class="detail-modal-body">
        <p class="text-muted mb-4">@L["Fill out the form below and our specialist will contact you within 24 hours."]</p>
        <form id="inqForm">
          @Html.AntiForgeryToken()
          <input type="hidden" name="collectionId" value="@Model.Id" />
          <input type="hidden" name="collectionTitle" value="@Model.Title" />
          <div class="mb-3">
            <label class="form-label">@L["First name"]</label>
            <input class="form-control" name="FirstName" maxlength="100" required />
          </div>
          <div class="mb-3">
            <label class="form-label">@L["Last name"]</label>
            <input class="form-control" name="LastName" maxlength="100" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" name="Email" type="email" maxlength="160" required />
          </div>
          <div class="mb-3">
            <label class="form-label">@L["Phone"]</label>
            <input class="form-control" name="Phone" type="tel" maxlength="40" />
          </div>
          <div class="mb-3">
            <label class="form-label">@L["Message"]</label>
            <textarea class="form-control" name="Message" rows="4" maxlength="5000" placeholder="@L["Tell us about your interest..."]"></textarea>
          </div>
        </form>
        <div id="inqOk" class="alert alert-success d-none">@L["Thank you. We will contact you soon."]</div>
        <div id="inqError" class="alert alert-danger d-none"></div>
      </div>
      <div class="detail-modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="closeInquiryForm()">@L["Close"]</button>
        <button type="button" class="btn btn-primary" onclick="submitInquiry()">
          <i class="bi bi-send me-2"></i>@L["Send"]
        </button>
      </div>
    </div>
  </div>
</div>

<style>
/* Collection Detail Page Styles - Aristocratic Theme */

/* Gallery Card */
.detail-gallery-card {
  background: var(--color-bg-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.main-image-container {
  position: relative;
  background: var(--color-bg-elevated);
  aspect-ratio: 4/3;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 350px;
  max-height: 500px;
}

.main-gallery-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  cursor: zoom-in;
  transition: transform var(--transition-slow);
}

/* Thumbnail Grid */
.thumbnail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 8px;
  padding: 12px;
  background: var(--color-bg-surface);
  border-top: 1px solid var(--color-border);
}

.thumbnail-item {
  aspect-ratio: 1;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-sm);
  overflow: hidden;
  cursor: pointer;
  border: 3px solid transparent;
  transition: all var(--transition-fast);
}

.thumbnail-item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: var(--color-bg-elevated);
}

.thumbnail-item:hover {
  border-color: var(--color-gold-dim) !important;
  transform: scale(1.05);
}

.thumbnail-item.active {
  border-color: var(--color-gold) !important;
  box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.3);
}

/* Price Section */
.detail-price-section {
  padding: 1.5rem;
  border-top: 1px solid var(--color-border);
}

.detail-badge-sold {
  background: rgba(128, 0, 32, 0.2);
  color: #ff6b6b;
  border: 1px solid rgba(128, 0, 32, 0.3);
  font-size: var(--text-lg);
  padding: 0.5rem 1.5rem;
}

.detail-badge-auction {
  background: rgba(234, 179, 8, 0.15);
  color: #eab308;
  border: 1px solid rgba(234, 179, 8, 0.3);
  font-size: var(--text-lg);
  padding: 0.5rem 1.5rem;
}

.detail-badge-available {
  background: rgba(34, 197, 94, 0.15);
  color: #22c55e;
  border: 1px solid rgba(34, 197, 94, 0.3);
  font-size: var(--text-base);
  padding: 0.5rem 1rem;
}

.detail-price {
  font-family: var(--font-heading);
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-gold);
}

/* Share & Comments Sections */
.detail-share-section,
.detail-comments-section {
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border);
}

.detail-section-title {
  font-family: var(--font-accent);
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-text-dim);
  margin-bottom: 0.75rem;
}

.copy-success-message {
  display: none;
  color: #22c55e;
  font-size: var(--text-xs);
}

/* Comment Form */
.comment-form-container {
  background: var(--color-bg-elevated);
  padding: 1rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}

.comment-login-notice {
  background: var(--color-bg-elevated);
  padding: 1rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

/* Info Card */
.detail-info-card {
  background: var(--color-bg-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  height: fit-content;
}

.detail-info-content {
  padding: 2rem;
}

.detail-title {
  font-family: var(--font-heading);
  font-size: var(--text-3xl);
  color: var(--color-text-main);
  margin-bottom: 1.5rem;
  line-height: 1.3;
}

.detail-description {
  color: var(--color-text-muted);
  line-height: 1.8;
}

/* AAS Verified Badge */
.aas-verified-badge {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.2);
  border-radius: var(--radius-md);
}

.aas-verified-badge img {
  width: 40px;
  height: 40px;
}

/* Audio Card */
.detail-audio-card {
  background: var(--color-bg-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 1.5rem;
  margin-top: 1rem;
}

.detail-audio-card h5 {
  color: var(--color-text-main);
  margin-bottom: 1rem;
}

.detail-audio-card audio {
  width: 100%;
  filter: invert(0.9);
}

/* Breadcrumb styling */
.breadcrumb-item + .breadcrumb-item::before {
  content: "/";
  color: var(--color-text-dim);
}

@@media (max-width: 768px) {
  .main-image-container {
    min-height: 250px;
    max-height: 400px;
  }
  
  .thumbnail-grid {
    grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)) !important;
    gap: 6px !important;
    padding: 8px !important;
    overflow-x: auto;
