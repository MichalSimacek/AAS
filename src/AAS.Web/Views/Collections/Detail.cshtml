@section Scripts{
<script>
// Image data
const imageData = [
  @for(int i = 0; i < images.Count; i++){
    @:{
    @:  src: '/uploads/images/@images[i].FileName-960.jpg',
    @:  full: '/uploads/images/@images[i].FileName-1600.jpg'
    @:}@(i < images.Count - 1 ? "," : "")
  }
];
let currentImageIndex = 0;
let currentZoom = 1;
const minZoom = 0.5;
const maxZoom = 4;
const zoomStep = 0.25;

// Thumbnail selection - Works on both desktop and mobile
function selectThumbnail(element, index) {
  // Update active state
  document.querySelectorAll('.thumbnail-item').forEach(t => t.classList.remove('active'));
  element.classList.add('active');
  
  // Update main image
  const mainImage = document.getElementById('mainImage');
  if (mainImage) {
    mainImage.src = element.dataset.src;
    mainImage.dataset.full = element.dataset.full;
  }
  
  currentImageIndex = index;
}

// Enhanced touch support for mobile thumbnails
document.addEventListener('DOMContentLoaded', function() {
  const thumbnails = document.querySelectorAll('.thumbnail-item');
  
  thumbnails.forEach(function(thumb) {
    // Remove onclick attribute and use event listeners instead for better mobile support
    thumb.removeAttribute('onclick');
    
    // Track touch state to distinguish tap from scroll
    let touchStartX = 0;
    let touchStartY = 0;
    let isTap = false;
    
    thumb.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      isTap = true;
    }, { passive: true });
    
    thumb.addEventListener('touchmove', function(e) {
      // If moved more than 10px, it's a scroll not a tap
      const dx = Math.abs(e.touches[0].clientX - touchStartX);
      const dy = Math.abs(e.touches[0].clientY - touchStartY);
      if (dx > 10 || dy > 10) {
        isTap = false;
      }
    }, { passive: true });
    
    thumb.addEventListener('touchend', function(e) {
      if (isTap) {
        e.preventDefault();
        const index = parseInt(this.dataset.index);
        selectThumbnail(this, index);
      }
    }, { passive: false });
    
    // Keep click for desktop
    thumb.addEventListener('click', function(e) {
      const index = parseInt(this.dataset.index);
      selectThumbnail(this, index);
    });
  });
});

// Social Share Functions
function shareOnFacebook() {
  const url = encodeURIComponent(window.location.href);
  window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, 'facebook-share', 'width=600,height=400');
}

function shareOnTwitter() {
  const url = encodeURIComponent(window.location.href);
  const text = encodeURIComponent('@Model.Title - Aristocratic Artwork Sale');
  window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, 'twitter-share', 'width=600,height=400');
}

function shareOnLinkedIn() {
  const url = encodeURIComponent(window.location.href);
  window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, 'linkedin-share', 'width=600,height=400');
}

async function copyLinkToClipboard() {
  try {
    await navigator.clipboard.writeText(window.location.href);
    const message = document.getElementById('copyMessage');
    if (message) {
      message.style.display = 'block';
      setTimeout(() => {
        message.style.display = 'none';
      }, 3000);
    }
  } catch (err) {
    const textArea = document.createElement('textarea');
    textArea.value = window.location.href;
    textArea.style.position = 'fixed';
    textArea.style.left = '-999999px';
    document.body.appendChild(textArea);
    textArea.select();
    try {
      document.execCommand('copy');
      const message = document.getElementById('copyMessage');
      if (message) {
        message.style.display = 'block';
        setTimeout(() => {
          message.style.display = 'none';
        }, 3000);
      }
    } catch (err) {
      alert('Failed to copy link. Please copy manually: ' + window.location.href);
    }
    document.body.removeChild(textArea);
  }
}

// Enhanced Lightbox with Zoom
function openLightbox(slideIndex) {
  currentImageIndex = slideIndex || 0;
  currentZoom = 1;
  
  const lightboxModal = document.getElementById('lightboxModal');
  const lightboxImage = document.getElementById('lightboxImage');
  
  if (lightboxModal && lightboxImage && imageData[currentImageIndex]) {
    lightboxImage.src = imageData[currentImageIndex].full;
    lightboxImage.style.transform = 'scale(1)';
    updateZoomLevel();
    updateCounter();
    
    lightboxModal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
}

function closeLightbox() {
  const lightboxModal = document.getElementById('lightboxModal');
  if (lightboxModal) {
    lightboxModal.style.display = 'none';
    document.body.style.overflow = '';
    lightboxReset();
  }
}

function lightboxPrev() {
  currentImageIndex = (currentImageIndex - 1 + imageData.length) % imageData.length;
  updateLightboxImage();
}

function lightboxNext() {
  currentImageIndex = (currentImageIndex + 1) % imageData.length;
  updateLightboxImage();
}

function updateLightboxImage() {
  const lightboxImage = document.getElementById('lightboxImage');
  if (lightboxImage && imageData[currentImageIndex]) {
    lightboxImage.style.opacity = '0.5';
    lightboxImage.src = imageData[currentImageIndex].full;
    lightboxImage.onload = function() {
      lightboxImage.style.opacity = '1';
    };
    lightboxReset();
    updateCounter();
  }
}

function updateCounter() {
  const counter = document.getElementById('lightboxCounter');
  if (counter) {
    counter.textContent = `${currentImageIndex + 1} / ${imageData.length}`;
  }
}

function lightboxZoomIn() {
  if (currentZoom < maxZoom) {
    currentZoom = Math.min(currentZoom + zoomStep, maxZoom);
    applyZoom();
  }
}

function lightboxZoomOut() {
  if (currentZoom > minZoom) {
    currentZoom = Math.max(currentZoom - zoomStep, minZoom);
    applyZoom();
  }
}

function lightboxReset() {
  currentZoom = 1;
  const lightboxImage = document.getElementById('lightboxImage');
  if (lightboxImage) {
    lightboxImage.style.transform = 'scale(1)';
    lightboxImage.style.transformOrigin = 'center center';
  }
  updateZoomLevel();
}

function applyZoom() {
  const lightboxImage = document.getElementById('lightboxImage');
  if (lightboxImage) {
    lightboxImage.style.transform = `scale(${currentZoom})`;
  }
  updateZoomLevel();
}

function updateZoomLevel() {
  const zoomLevel = document.getElementById('zoomLevel');
  if (zoomLevel) {
    zoomLevel.textContent = `${Math.round(currentZoom * 100)}%`;
  }
}

// Keyboard navigation
document.addEventListener('keydown', function(e) {
  const lightboxModal = document.getElementById('lightboxModal');
  if (lightboxModal && lightboxModal.style.display === 'flex') {
    switch(e.key) {
      case 'Escape':
        closeLightbox();
        break;
      case 'ArrowLeft':
        lightboxPrev();
        break;
      case 'ArrowRight':
        lightboxNext();
        break;
      case '+':
      case '=':
        lightboxZoomIn();
        break;
      case '-':
        lightboxZoomOut();
        break;
      case '0':
        lightboxReset();
        break;
    }
  }
});

// Mouse wheel zoom
document.getElementById('lightboxModal')?.addEventListener('wheel', function(e) {
  if (e.target.closest('.lightbox-content')) {
    e.preventDefault();
    if (e.deltaY < 0) {
      lightboxZoomIn();
    } else {
      lightboxZoomOut();
    }
  }
}, { passive: false });

// Simple modal open/close functions
function openInquiryForm() {
  const modal = document.getElementById('interestModal');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
}

function closeInquiryForm() {
  const modal = document.getElementById('interestModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    const form = document.getElementById('inqForm');
    if (form) form.reset();
    document.getElementById('inqOk')?.classList.add('d-none');
    document.getElementById('inqError')?.classList.add('d-none');
  }
}

// Close modal when clicking on backdrop
document.getElementById('interestModal')?.addEventListener('click', function(e) {
  if (e.target === this) {
    closeInquiryForm();
  }
});

// Close modal on ESC key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeInquiryForm();
  }
});

// Comments functionality
document.addEventListener('DOMContentLoaded', function() {
  const collectionId = @Model.Id;
  const isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
  const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");
  
  // Load comments
  loadComments();
  
  function loadComments() {
    loadCommentsAndHighlight(null);
  }
  
  function loadCommentsAndHighlight(highlightId) {
    console.log('Loading comments for collection:', collectionId, 'highlightId:', highlightId);
    // Add timestamp to prevent caching
    const timestamp = new Date().getTime();
    fetch(`/api/Comments/collection/${collectionId}?t=${timestamp}`, {
      cache: 'no-store',
      headers: {
        'Cache-Control': 'no-cache'
      }
    })
      .then(response => {
        console.log('Comments API response status:', response.status);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(comments => {
        console.log('Loaded comments (total:', comments.length, '):', comments);
        renderComments(comments, highlightId);
      })
      .catch(error => {
        console.error('Error loading comments:', error);
        document.getElementById('commentsList').innerHTML = '<div class="alert alert-danger">@L["Failed to load comments"]</div>';
      });
  }
  
  function renderComments(comments, highlightId = null) {
    console.log('renderComments called with:', comments, 'highlightId:', highlightId);
    const container = document.getElementById('commentsList');
    console.log('commentsList container:', container);
    
    if (!container) {
      console.error('commentsList container not found!');
      return;
    }
    
    if (comments.length === 0) {
      container.innerHTML = '<p class="text-muted">@L["No comments yet. Be the first to comment!"]</p>';
      return;
    }
    
    const currentUserId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
    console.log('Current user ID:', currentUserId, 'isAuthenticated:', isAuthenticated, 'isAdmin:', isAdmin);
    
    try {
      let html = '';
      comments.forEach((comment, index) => {
        console.log(`Processing comment ${index}:`, comment);
        
        const date = new Date(comment.createdAt).toLocaleDateString('@System.Globalization.CultureInfo.CurrentCulture.Name');
        const updated = comment.updatedAt ? ' <small class="text-muted">(@L["edited"])</small>' : '';
        const safeUserName = escapeHtml(comment.userName || 'Unknown');
        const safeText = escapeHtml(comment.text || '');
        const highlightClass = (highlightId && comment.id === highlightId) ? ' comment-just-updated' : '';
        
        html += `
          <div class="card mb-3${highlightClass}" data-comment-id="${comment.id}">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong>${safeUserName}</strong>
                  <small class="text-muted ms-2">${date}${updated}</small>
                </div>`;
        
        // Show edit/delete buttons if user is owner or admin
        if (isAuthenticated && (comment.userId === currentUserId || isAdmin)) {
          const dataText = safeText.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
          html += `
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-primary btn-sm" onclick="editComment(${comment.id}, this.getAttribute('data-text'))" data-text="${dataText}">@L["Edit"]</button>
                  <button class="btn btn-outline-danger btn-sm" onclick="deleteComment(${comment.id})">@L["Delete"]</button>
                </div>`;
        }
        
        html += `
              </div>
              <p class="mt-2 mb-0 comment-text">${safeText}</p>
            </div>
          </div>`;
      });
      
      console.log('Final HTML length:', html.length);
      console.log('Setting innerHTML...');
      container.innerHTML = html;
      console.log('Comments rendered successfully');
      
      // Remove highlight after animation
      if (highlightId) {
        setTimeout(() => {
          const highlightedCard = document.querySelector('.comment-just-updated');
          if (highlightedCard) {
            highlightedCard.classList.remove('comment-just-updated');
          }
        }, 2000);
      }
      
      // Scroll to comments if not visible
      setTimeout(() => {
        const rect = container.getBoundingClientRect();
        console.log('Container position:', rect);
        if (rect.top < 0 || rect.bottom > window.innerHeight) {
          console.log('Scrolling to comments...');
          container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }, 100);
    } catch (error) {
      console.error('Error rendering comments:', error);
      container.innerHTML = '<div class="alert alert-danger">Error displaying comments. Please refresh the page.</div>';
    }
  }
  
  // Submit new comment
  if (isAuthenticated) {
    document.getElementById('commentForm')?.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const token = this.querySelector('[name="__RequestVerificationToken"]').value;
      
      fetch('/api/Comments', {
        method: 'POST',
        headers: {
          'X-CSRF-TOKEN': token,
          'RequestVerificationToken': token
        },
        body: formData
      })
      .then(response => {
        if (!response.ok) {
          return response.text().then(text => {
            console.error('Server response:', text);
            throw new Error('Failed to post comment');
          });
        }
        return response.json();
      })
      .then(data => {
        console.log('Comment created:', data);
        document.getElementById('commentText').value = '';
        loadComments();
      })
      .catch(error => {
        console.error('Error:', error);
        alert('@L["Failed to post comment. Please try again."]');
      });
    });
  }
  
  // Edit comment - Open modern dialog
  window.editComment = function(commentId, currentTextElement) {
    // Get text from data attribute
    let currentText = '';
    if (typeof currentTextElement === 'string') {
      currentText = currentTextElement;
    } else if (currentTextElement && currentTextElement.getAttribute) {
      currentText = currentTextElement.getAttribute('data-text') || '';
    }
    
    // Decode HTML entities
    const textarea = document.createElement('textarea');
    textarea.innerHTML = currentText;
    const decodedText = textarea.value;
    
    // Open the modern edit dialog
    openEditCommentDialog(commentId, decodedText);
  };
  
  // Open edit dialog
  function openEditCommentDialog(commentId, currentText) {
    const modal = document.getElementById('editCommentModal');
    const textArea = document.getElementById('editCommentText');
    
    textArea.value = currentText;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Focus textarea and select text
    setTimeout(() => {
      textArea.focus();
      textArea.setSelectionRange(0, textArea.value.length);
    }, 100);
    
    // Store comment ID for submission
    modal.setAttribute('data-comment-id', commentId);
  }
  
  // Close edit dialog
  window.closeEditCommentDialog = function() {
    const modal = document.getElementById('editCommentModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  };
  
  // Submit edited comment
  window.submitEditComment = function() {
    const modal = document.getElementById('editCommentModal');
    const commentId = modal.getAttribute('data-comment-id');
    const textArea = document.getElementById('editCommentText');
    const newText = textArea.value.trim();
    
    if (!newText) {
      alert('@L["Comment cannot be empty"]');
      return;
    }
    
    if (newText.length > 2000) {
      alert('@L["Comment is too long (max 2000 characters)"]');
      return;
    }
    
    // Show loading
    const submitBtn = document.getElementById('submitEditBtn');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> @L["Saving..."]';
    
    const formData = new FormData();
    formData.append('text', newText);
    
    const token = document.querySelector('[name="__RequestVerificationToken"]').value;
    
    console.log('Updating comment:', commentId, 'with text:', newText);
    
    fetch(`/api/Comments/${commentId}`, {
      method: 'PUT',
      headers: {
        'RequestVerificationToken': token
      },
      body: formData
    })
    .then(response => {
      console.log('Update response status:', response.status);
      if (!response.ok) {
        return response.text().then(text => {
          console.error('Update failed with response:', text);
          throw new Error('Failed to update comment');
        });
      }
      return response.json();
    })
    .then(data => {
      console.log('Comment updated successfully:', data);
      closeEditCommentDialog();
      
      // Store the updated comment ID for highlighting
      window.lastUpdatedCommentId = commentId;
      
      // Wait a moment then reload comments with cache busting
      setTimeout(() => {
        console.log('Reloading comments after update...');
        loadCommentsAndHighlight(commentId);
      }, 100);
    })
    .catch(error => {
      console.error('Error updating comment:', error);
      alert('@L["Failed to update comment. Please try again."]');
    })
    .finally(() => {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    });
  };
  
  // Delete comment - Open confirmation dialog
  window.deleteComment = function(commentId) {
    openDeleteCommentDialog(commentId);
  };
  
  // Open delete confirmation dialog
  function openDeleteCommentDialog(commentId) {
    const modal = document.getElementById('deleteCommentModal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Store comment ID for deletion
    modal.setAttribute('data-comment-id', commentId);
  }
  
  // Close delete dialog
  window.closeDeleteCommentDialog = function() {
    const modal = document.getElementById('deleteCommentModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  };
  
  // Confirm and delete comment
  window.confirmDeleteComment = function() {
    const modal = document.getElementById('deleteCommentModal');
    const commentId = modal.getAttribute('data-comment-id');
    
    // Show loading
    const deleteBtn = document.getElementById('confirmDeleteBtn');
    const originalText = deleteBtn.innerHTML;
    deleteBtn.disabled = true;
    deleteBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> @L["Deleting..."]';
    
    const token = document.querySelector('[name="__RequestVerificationToken"]').value;
    
    fetch(`/api/Comments/${commentId}`, {
      method: 'DELETE',
      headers: {
        'RequestVerificationToken': token
      }
    })
    .then(response => {
      if (!response.ok) throw new Error('Failed to delete comment');
      closeDeleteCommentDialog();
      loadComments();
    })
    .catch(error => {
      console.error('Error:', error);
      alert('@L["Failed to delete comment. Please try again."]');
    })
    .finally(() => {
      deleteBtn.disabled = false;
      deleteBtn.innerHTML = originalText;
    });
  };
  
  // Utility function to escape HTML
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  // Close modal on ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const editModal = document.getElementById('editCommentModal');
      const deleteModal = document.getElementById('deleteCommentModal');
      
      if (editModal && editModal.style.display === 'flex') {
        closeEditCommentDialog();
      } else if (deleteModal && deleteModal.style.display === 'flex') {
        closeDeleteCommentDialog();
      }
    }
  });
  
  // Close modal on backdrop click
  document.getElementById('editCommentModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
      closeEditCommentDialog();
    }
  });
  
  document.getElementById('deleteCommentModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
      closeDeleteCommentDialog();
    }
  });
});
</script>

<!-- Modern Edit Comment Dialog -->
<div id="editCommentModal" class="detail-modal">
  <div class="detail-modal-content" style="max-width: 600px;">
    <div class="detail-modal-header">
      <h5><i class="bi bi-pencil-square text-gold me-2"></i>@L["Edit Comment"]</h5>
      <button type="button" onclick="closeEditCommentDialog()" class="detail-modal-close">&times;</button>
    </div>
    <div class="detail-modal-body">
      <label for="editCommentText" class="form-label">@L["Your Comment"]</label>
      <textarea 
        id="editCommentText" 
        class="form-control"
        rows="6" 
        maxlength="2000"
        placeholder="@L["Write your comment here..."]"
      ></textarea>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <small class="text-muted">
          <i class="bi bi-info-circle me-1"></i>@L["Maximum 2000 characters"]
        </small>
        <small id="charCount" class="text-muted"></small>
      </div>
    </div>
    <div class="detail-modal-footer">
      <button type="button" class="btn btn-outline-secondary" onclick="closeEditCommentDialog()">
        <i class="bi bi-x-circle me-2"></i>@L["Cancel"]
      </button>
      <button type="button" id="submitEditBtn" class="btn btn-primary" onclick="submitEditComment()">
        <i class="bi bi-check-circle me-2"></i>@L["Save Changes"]
      </button>
    </div>
  </div>
</div>

<style>
@@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(-50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>

<!-- Modern Delete Comment Dialog -->
<div id="deleteCommentModal" class="detail-modal" style="z-index: 1056;">
  <div class="detail-modal-content" style="max-width: 500px;">
    <div class="detail-modal-header" style="border-bottom-color: var(--color-accent-red);">
      <h5 style="color: #ff6b6b;"><i class="bi bi-exclamation-triangle-fill me-2"></i>@L["Confirm Deletion"]</h5>
      <button type="button" onclick="closeDeleteCommentDialog()" class="detail-modal-close">&times;</button>
    </div>
    <div class="detail-modal-body text-center">
      <div class="mb-3">
        <i class="bi bi-trash3" style="font-size: 48px; color: #ff6b6b;"></i>
      </div>
      <h6 class="mb-3">@L["Are you sure?"]</h6>
      <p class="text-muted mb-3">@L["Do you really want to delete this comment?"]</p>
      <p class="mb-0" style="color: #ff6b6b; font-size: var(--text-sm);">
        <i class="bi bi-exclamation-triangle me-1"></i>@L["This action cannot be undone."]
      </p>
    </div>
    <div class="detail-modal-footer">
      <button type="button" class="btn btn-outline-secondary" onclick="closeDeleteCommentDialog()">
        <i class="bi bi-x-circle me-2"></i>@L["Cancel"]
      </button>
      <button type="button" id="confirmDeleteBtn" class="btn" style="background: #ff6b6b; border-color: #ff6b6b; color: white;" onclick="confirmDeleteComment()">
        <i class="bi bi-trash3 me-2"></i>@L["Delete Comment"]
      </button>
    </div>
  </div>
</div>


<script>
// Character counter
document.addEventListener('DOMContentLoaded', function() {
  const textarea = document.getElementById('editCommentText');
  const charCount = document.getElementById('charCount');
  
  if (textarea && charCount) {
    textarea.addEventListener('input', function() {
      const remaining = 2000 - this.value.length;
      charCount.textContent = `${this.value.length} / 2000`;
      
      if (remaining < 100) {
        charCount.style.color = '#DC3545';
      } else {
        charCount.style.color = '#6c757d';
      }
    });
  }
});
</script>
}
