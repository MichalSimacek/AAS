@using AAS.Web.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Collections"];
    var categoryCounts = ViewBag.CategoryCounts as Dictionary<CollectionCategory, int> ?? new Dictionary<CollectionCategory, int>();
    var categoryImages = ViewBag.CategoryImages as Dictionary<CollectionCategory, string?> ?? new Dictionary<CollectionCategory, string?>();
    
    // Define categories with their display info
    var categories = new[] {
        new { Cat = CollectionCategory.Paintings, Icon = "bi-palette", Key = "Paintings" },
        new { Cat = CollectionCategory.Jewelry, Icon = "bi-gem", Key = "Jewelry" },
        new { Cat = CollectionCategory.Watches, Icon = "bi-stopwatch", Key = "Watches" },
        new { Cat = CollectionCategory.Statues, Icon = "bi-person-bounding-box", Key = "Statues" },
        new { Cat = CollectionCategory.Other, Icon = "bi-stars", Key = "Decorative Arts" }
    };
}

<div class="collections-landing">
    <!-- Hero Section -->
    <section class="landing-hero">
        <div class="container">
            <div class="hero-content text-center">
                <h1 class="hero-title">@L["Collections"]</h1>
                <div class="hero-divider"></div>
                <p class="hero-subtitle">@L["Home Description"]</p>
            </div>
        </div>
    </section>

    <!-- Categories Grid -->
    <section class="categories-section">
        <div class="container">
            <div class="section-header text-center mb-5">
                <h2 class="section-title">@L["Explore collections"]</h2>
                <p class="section-subtitle">@L["Collections Description"]</p>
            </div>
            
            <div class="categories-grid">
                @foreach (var cat in categories)
                {
                    var count = categoryCounts.ContainsKey(cat.Cat) ? categoryCounts[cat.Cat] : 0;
                    var image = categoryImages.ContainsKey(cat.Cat) ? categoryImages[cat.Cat] : null;
                    
                    <a href="/Collections?category=@cat.Cat" class="category-card" data-testid="category-@cat.Cat.ToString().ToLower()">
                        <div class="category-image-wrapper">
                            @if (!string.IsNullOrEmpty(image))
                            {
                                <img src="/uploads/images/@(image)-960.jpg" 
                                     alt="@L[cat.Key]" 
                                     class="category-image"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="category-placeholder">
                                    <i class="bi @cat.Icon"></i>
                                </div>
                            }
                            <div class="category-overlay"></div>
                        </div>
                        <div class="category-content">
                            <div class="category-icon">
                                <i class="bi @cat.Icon"></i>
                            </div>
                            <h3 class="category-title">@L[cat.Key]</h3>
                            <p class="category-count">
                                @if (count > 0)
                                {
                                    <span>@count @(count == 1 ? L["item"] : L["items"])</span>
                                }
                                else
                                {
                                    <span>@L["Coming soon"]</span>
                                }
                            </p>
                            <span class="category-cta">
                                @L["Explore"] <i class="bi bi-arrow-right ms-2"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Info Section -->
    <section class="info-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="info-content">
                        <h2 class="info-title">@L["Why Choose Us"]</h2>
                        <p class="info-text">@L["BuyOrSellDetails"]</p>
                        
                        <div class="info-features">
                            <div class="info-feature">
                                <i class="bi bi-shield-check"></i>
                                <span>@L["Complete Discretion"]</span>
                            </div>
                            <div class="info-feature">
                                <i class="bi bi-award"></i>
                                <span>@L["Expert Service"]</span>
                            </div>
                            <div class="info-feature">
                                <i class="bi bi-cash-stack"></i>
                                <span>@L["Highest Prices"]</span>
                            </div>
                        </div>
                        
                        <div class="info-actions">
                            <a href="/HowTo" class="btn btn-primary btn-lg">
                                <i class="bi bi-book me-2"></i>@L["LearnMore"]
                            </a>
                            <a href="/Contacts" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-envelope me-2"></i>@L["Contact Us"]
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="aas-badge-showcase">
                        <img src="~/images/aas-verified-badge.svg" alt="AAS Verified" class="aas-badge-large" />
                        <h3>@L["WhatIsAASVerified"]</h3>
                        <p>@L["AASVerifiedExplanation"]</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
/* Landing Page Styles */
.collections-landing {
    min-height: 100vh;
}

/* Hero Section */
.landing-hero {
    background: linear-gradient(135deg, #1A1A1A 0%, #2A2A2A 100%);
    padding: 80px 0;
    text-align: center;
}

.hero-title {
    font-family: var(--font-primary);
    font-size: 56px;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
}

.hero-divider {
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, #B8941F 0%, #C9A961 100%);
    margin: 0 auto 24px;
    border-radius: 2px;
}

.hero-subtitle {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Categories Section */
.categories-section {
    padding: 80px 0;
    background: #FAFAFA;
}

.section-title {
    font-family: var(--font-primary);
    font-size: 36px;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 12px;
}

.section-subtitle {
    font-size: 18px;
    color: #6B6B6B;
}

.categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.categories-grid .category-card:nth-child(4),
.categories-grid .category-card:nth-child(5) {
    grid-column: span 1;
}

/* First row: 3 cards, second row: 2 cards centered */
@@media (min-width: 992px) {
    .categories-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 24px;
    }
    
    .categories-grid .category-card {
        width: calc(33.333% - 16px);
        max-width: 380px;
    }
    
    .categories-grid .category-card:nth-child(4),
    .categories-grid .category-card:nth-child(5) {
        width: calc(33.333% - 16px);
    }
}

.category-card {
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #FFFFFF;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.category-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

.category-image-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
}

.category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.category-card:hover .category-image {
    transform: scale(1.08);
}

.category-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #E8E8E8 0%, #D0D0D0 100%);
}

.category-placeholder i {
    font-size: 64px;
    color: #999;
}

.category-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 60%);
    pointer-events: none;
}

.category-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    color: #FFFFFF;
    text-align: left;
}

.category-icon {
    width: 48px;
    height: 48px;
    background: rgba(184, 148, 31, 0.9);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    backdrop-filter: blur(4px);
}

.category-icon i {
    font-size: 24px;
    color: #FFFFFF;
}

.category-title {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 4px;
}

.category-count {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 12px;
}

.category-cta {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: #C9A961;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
}

.category-card:hover .category-cta {
    opacity: 1;
    transform: translateX(0);
}

/* Info Section */
.info-section {
    padding: 100px 0;
    background: #FFFFFF;
}

.info-title {
    font-family: var(--font-primary);
    font-size: 36px;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 20px;
}

.info-text {
    font-size: 18px;
    color: #4A4A4A;
    line-height: 1.7;
    margin-bottom: 32px;
}

.info-features {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 40px;
}

.info-feature {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 500;
    color: #1A1A1A;
}

.info-feature i {
    font-size: 24px;
    color: #B8941F;
}

.info-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.aas-badge-showcase {
    text-align: center;
    padding: 48px;
    background: linear-gradient(135deg, #FAFAFA 0%, #F5F5F5 100%);
    border-radius: 24px;
    border: 1px solid #E5E5E5;
}

.aas-badge-large {
    width: 120px;
    height: 120px;
    margin-bottom: 24px;
}

.aas-badge-showcase h3 {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 12px;
}

.aas-badge-showcase p {
    font-size: 16px;
    color: #4A4A4A;
    line-height: 1.6;
}

/* Responsive */
@@media (max-width: 991px) {
    .hero-title {
        font-size: 42px;
    }
    
    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .categories-grid .category-card {
        width: 100%;
    }
}

@@media (max-width: 767px) {
    .landing-hero {
        padding: 60px 0;
    }
    
    .hero-title {
        font-size: 32px;
    }
    
    .hero-subtitle {
        font-size: 16px;
    }
    
    .categories-section {
        padding: 60px 0;
    }
    
    .categories-grid {
        grid-template-columns: 1fr;
    }
    
    .category-image-wrapper {
        height: 180px;
    }
    
    .info-section {
        padding: 60px 0;
    }
    
    .info-actions {
        flex-direction: column;
    }
    
    .info-actions .btn {
        width: 100%;
    }
}
</style>
