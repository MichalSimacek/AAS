@model IEnumerable<AAS.Web.Models.Collection>
@using AAS.Web.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L

<!-- Collections Page -->
<section class="section">
  <div class="container">
    <!-- Header -->
    <div class="text-center mb-5">
      <p class="text-accent text-gold mb-3">@L["Browse"]</p>
      <h1 style="font-family: var(--font-heading); font-size: var(--text-5xl);">@L["Collections"]</h1>
      <p class="lead text-muted mt-3" style="max-width: 600px; margin: 0 auto;">
        @L["Home Description"]
      </p>
    </div>

    <!-- Category Filter -->
    <div class="category-filter justify-content-center mb-5">
      <a class="btn btn-sm @(ViewBag.Category?.ToString() == "Paintings" ? "active" : "")" href="/Collections?category=Paintings">@L["Paintings"]</a>
      <a class="btn btn-sm @(ViewBag.Category?.ToString() == "Jewelry" ? "active" : "")" href="/Collections?category=Jewelry">@L["Jewelry"]</a>
      <a class="btn btn-sm @(ViewBag.Category?.ToString() == "Watches" ? "active" : "")" href="/Collections?category=Watches">@L["Watches"]</a>
      <a class="btn btn-sm @(ViewBag.Category?.ToString() == "Statues" ? "active" : "")" href="/Collections?category=Statues">@L["Statues"]</a>
      <a class="btn btn-sm @(ViewBag.Category?.ToString() == "GoldSilver" ? "active" : "")" href="/Collections?category=GoldSilver">@L["Gold & Silver"]</a>
      <a class="btn btn-sm @(ViewBag.Category?.ToString() == "Other" ? "active" : "")" href="/Collections?category=Other">@L["Decorative Arts"]</a>
    </div>

    @if (!Model.Any())
    {
      <div class="text-center py-5">
        <div class="mb-4">
          <i class="bi bi-collection" style="font-size: 64px; color: var(--color-text-dim);"></i>
        </div>
        <h3 class="mb-3">@L["No Collections Yet"]</h3>
        <p class="text-muted">@L["Start by creating your first aristocratic collection"]</p>
        <a href="/Collections/Landing" class="btn btn-outline-secondary mt-3">
          <i class="bi bi-arrow-left me-2"></i>@L["Back"]
        </a>
      </div>
    }
    else
    {
      <div class="collection-grid">
        @foreach (var c in Model)
        {
          var first = c.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
          <a class="collection-card" href="/Collections/Details/@c.Slug" data-testid="collection-@c.Slug">
            <div style="position: relative; overflow: hidden;">
              @if(first != null)
              {
                <img loading="lazy" alt="@c.Title"
                     src="/uploads/images/@first.FileName-480.jpg"
                     srcset="/uploads/images/@first.FileName-480.jpg 480w, /uploads/images/@first.FileName-960.jpg 960w"
                     sizes="(max-width: 768px) 50vw, 25vw" />
              }
              else
              {
                <div style="width: 100%; height: 280px; background: var(--color-bg-elevated); display: flex; align-items: center; justify-content: center;">
                  <i class="bi bi-image" style="font-size: 48px; color: var(--color-text-dim);"></i>
                </div>
              }
              
              @* AAS Verified badge *@
              @if (c.AASVerified)
              {
                <div style="position: absolute; top: 12px; left: 12px;">
                  <span class="badge badge-purple">
                    <i class="bi bi-patch-check me-1"></i>AAS Verified
                  </span>
                </div>
              }
              
              @* Status badge *@
              @if (c.Status == CollectionStatus.Sold)
              {
                <div style="position: absolute; top: 12px; right: 12px;">
                  <span class="badge" style="background: rgba(128, 0, 32, 0.9); color: #fff;">@L["Sold"]</span>
                </div>
              }
            </div>
            
            <div class="card-body">
              @* Price display *@
              @if (c.Status == CollectionStatus.Available && !string.IsNullOrWhiteSpace(c.Price))
              {
                <div class="collection-price mb-2">
                  @{
                    if (decimal.TryParse(c.Price, out decimal priceValue))
                    {
                      if (c.Currency == Currency.EUR)
                      {
                        @string.Format("{0:N0} €", priceValue)
                      }
                      else
                      {
                        @string.Format("$ {0:N0}", priceValue)
                      }
                    }
                    else
                    {
                      @c.Price
                    }
                  }
                </div>
              }
              
              <h5 class="card-title">
                @{
                  var translations = ViewBag.Translations as Dictionary<int, string>;
                  var title = (translations != null && translations.ContainsKey(c.Id)) ? translations[c.Id] : c.Title;
                }
                @title
              </h5>
              <span class="badge badge-gold">@L[c.Category.ToString()]</span>
            </div>
          </a>
        }
      </div>
    }
    
    @* Pagination *@
    @{
      var currentPage = ViewBag.CurrentPage ?? 1;
      var totalPages = ViewBag.TotalPages ?? 1;
      var filterCategory = ViewBag.Category;
    }
    @if (Model.Any() && (int)totalPages > 1)
    {
      <nav class="mt-5 d-flex justify-content-center">
        <ul class="pagination">
          @for (int i = 1; i <= (int)totalPages; i++)
          {
            var activeClass = i == (int)currentPage ? "active" : "";
            var href = filterCategory != null ? $"/Collections?category={filterCategory}&page={i}" : $"/Collections?page={i}";
            <li class="page-item @activeClass">
              <a class="page-link" href="@href" style="background: var(--color-bg-surface); border-color: var(--color-border); color: var(--color-text-muted);">@i</a>
            </li>
          }
        </ul>
      </nav>
    }
  </div>
</section>
