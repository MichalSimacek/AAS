@model AAS.Web.Models.BlogPost
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@using System.Globalization

@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var title = AAS.Web.Controllers.BlogController.GetLocalizedTitle(Model, currentCulture) ?? "Blog Post";
    var content = AAS.Web.Controllers.BlogController.GetLocalizedContent(Model, currentCulture) ?? "";
    
    ViewData["Title"] = title;
}

<!-- Hero Section with Featured Image -->
@if (!string.IsNullOrEmpty(Model.FeaturedImage))
{
    <section class="blog-hero" style="position: relative; min-height: 50vh; display: flex; align-items: flex-end; overflow: hidden;">
        <div class="blog-hero-image" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <img src="@Model.FeaturedImage" alt="@title" style="width: 100%; height: 100%; object-fit: cover; filter: brightness(0.5);" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 60%; background: linear-gradient(to top, var(--color-bg-main) 0%, transparent 100%);"></div>
        </div>
        <div class="container position-relative" style="padding-bottom: 3rem; z-index: 1;">
            <nav aria-label="breadcrumb" class="mb-4 animate-fade-in">
                <ol class="breadcrumb" style="background: transparent; padding: 0; margin: 0;">
                    <li class="breadcrumb-item">
                        <a href="/" class="text-gold"><i class="bi bi-house me-1"></i>@L["Home"]</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/Blog" class="text-gold">@L["Blog"]</a>
                    </li>
                    <li class="breadcrumb-item active text-muted" aria-current="page" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@title</li>
                </ol>
            </nav>
            <h1 class="hero-title animate-fade-in delay-1" style="font-size: var(--text-5xl); max-width: 900px; text-align: left;">@title</h1>
            <div class="d-flex align-items-center gap-4 mt-4 animate-fade-in delay-2">
                <span class="text-gold">
                    <i class="bi bi-calendar3 me-2"></i>@Model.CreatedAt.ToString("dd MMMM yyyy", CultureInfo.CurrentCulture)
                </span>
                @if (Model.UpdatedAt.HasValue)
                {
                    <span class="text-muted">
                        <i class="bi bi-pencil me-2"></i>@L["Updated"]: @Model.UpdatedAt.Value.ToString("dd.MM.yyyy")
                    </span>
                }
            </div>
        </div>
    </section>
}
else
{
    <section class="hero" style="min-height: 40vh; padding: 80px 0;">
        <div class="hero-content" style="text-align: left; max-width: 1400px; width: 100%;">
            <div class="container">
                <nav aria-label="breadcrumb" class="mb-4 animate-fade-in">
                    <ol class="breadcrumb" style="background: transparent; padding: 0; margin: 0;">
                        <li class="breadcrumb-item">
                            <a href="/" class="text-gold"><i class="bi bi-house me-1"></i>@L["Home"]</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/Blog" class="text-gold">@L["Blog"]</a>
                        </li>
                        <li class="breadcrumb-item active text-muted" aria-current="page">@title</li>
                    </ol>
                </nav>
                <h1 class="hero-title animate-fade-in delay-1" style="font-size: var(--text-5xl); text-align: left;">@title</h1>
                <div class="d-flex align-items-center gap-4 mt-4 animate-fade-in delay-2">
                    <span class="text-gold">
                        <i class="bi bi-calendar3 me-2"></i>@Model.CreatedAt.ToString("dd MMMM yyyy", CultureInfo.CurrentCulture)
                    </span>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <span class="text-muted">
                            <i class="bi bi-pencil me-2"></i>@L["Updated"]: @Model.UpdatedAt.Value.ToString("dd.MM.yyyy")
                        </span>
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- Article Content -->
<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 reveal">
                <article class="blog-article">
                    @if (!string.IsNullOrWhiteSpace(content))
                    {
                        <div class="blog-content">
                            @Html.Raw(content)
                        </div>
                    }
                    else
                    {
                        <div class="gradient-border p-4 text-center">
                            <i class="bi bi-translate text-gold mb-3" style="font-size: 48px;"></i>
                            <p class="text-muted mb-0">
                                @L["Content not available in the selected language. Please try switching to Czech."]
                            </p>
                        </div>
                    }
                </article>
                
                <!-- Back to Blog -->
                <div class="mt-5 pt-4" style="border-top: 1px solid var(--color-border);">
                    <a href="/Blog" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>@L["Back to Blog"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Related CTA -->
<section class="section section-dark">
    <div class="container">
        <div class="text-center reveal">
            <p class="text-accent text-gold mb-3">@L["Explore More"]</p>
            <h2 style="font-size: var(--text-3xl); margin-bottom: 1.5rem;">@L["Discover Our Collections"]</h2>
            <p class="text-muted mb-4" style="max-width: 600px; margin: 0 auto;">
                @L["Browse our curated selection of luxury artwork and collectibles"]
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/Collections/Landing" class="btn btn-primary">
                    <i class="bi bi-grid me-2"></i>@L["Browse Collections"]
                </a>
                <a href="/Contacts" class="btn btn-outline-secondary">
                    <i class="bi bi-envelope me-2"></i>@L["Contact Us"]
                </a>
            </div>
        </div>
    </div>
</section>

<style>
/* Blog Article Styles */
.blog-article {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 3rem;
}

.blog-content {
    font-size: var(--text-lg);
    line-height: 1.9;
    color: var(--color-text-main);
}

.blog-content p {
    margin-bottom: 1.75rem;
    color: var(--color-text-muted);
}

.blog-content img {
    max-width: 100%;
    height: auto;
    margin: 2.5rem 0;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
}

.blog-content h1, 
.blog-content h2, 
.blog-content h3, 
.blog-content h4 {
    font-family: var(--font-heading);
    color: var(--color-text-main);
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
}

.blog-content h1 { font-size: var(--text-4xl); }
.blog-content h2 { font-size: var(--text-3xl); }
.blog-content h3 { font-size: var(--text-2xl); }
.blog-content h4 { font-size: var(--text-xl); }

.blog-content ul, 
.blog-content ol {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
}

.blog-content li {
    margin-bottom: 0.5rem;
}

.blog-content li::marker {
    color: var(--color-gold);
}

.blog-content blockquote {
    border-left: 4px solid var(--color-gold);
    padding: 1.5rem 2rem;
    margin: 2.5rem 0;
    background: var(--color-bg-elevated);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--color-text-muted);
}

.blog-content blockquote p:last-child {
    margin-bottom: 0;
}

.blog-content a {
    color: var(--color-gold);
    text-decoration: underline;
    text-decoration-color: rgba(212, 175, 55, 0.3);
    text-underline-offset: 3px;
    transition: all var(--transition-fast);
}

.blog-content a:hover {
    color: var(--color-gold-light);
    text-decoration-color: var(--color-gold-light);
}

.blog-content code {
    background: var(--color-bg-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    color: var(--color-gold);
}

.blog-content pre {
    background: var(--color-bg-elevated);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 2rem 0;
}

.blog-content pre code {
    background: transparent;
    padding: 0;
}

/* Breadcrumb styling */
.breadcrumb-item + .breadcrumb-item::before {
    content: "/";
    color: var(--color-text-dim);
}

@@media (max-width: 768px) {
    .blog-article {
        padding: 1.5rem;
    }
    
    .blog-content {
        font-size: var(--text-base);
    }
}
</style>
