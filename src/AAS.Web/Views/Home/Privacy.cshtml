@{
    ViewData["Title"] = "Privacy Policy - Zásady ochrany osobních údajů";
    ViewData["Description"] = "Privacy Policy and GDPR compliance information for Aristocratic Artwork Sale";
}

<div class="section privacy-hero">
    <div class="container">
        <div class="text-center reveal">
            <span class="badge badge-gold mb-3">GDPR</span>
            <h1 class="hero-title">Privacy Policy</h1>
            <p class="hero-subtitle">Zásady ochrany osobních údajů</p>
            <p class="updated-date"><i class="bi bi-calendar3 me-2"></i>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                
                <div class="privacy-card gradient-border reveal">
                    <div class="privacy-card-header">
                        <span class="privacy-number">01</span>
                        <h2>Information We Collect</h2>
                        <p class="text-muted">Informace, které shromažďujeme</p>
                    </div>
                    <div class="privacy-card-body">
                        <p>We collect information you provide directly to us, such as when you create an account, make inquiries about collections, or contact us.</p>
                        <p class="text-muted"><em>Shromažďujeme informace, které nám přímo poskytujete, například když si vytvoříte účet, dotazujete se na kolekce nebo nás kontaktujete.</em></p>
                        
                        <h3 class="mt-4"><i class="bi bi-person-lines-fill text-gold me-2"></i>Personal Information:</h3>
                        <ul class="privacy-list">
                            <li>Name, email address, phone number</li>
                            <li>Account credentials and preferences</li>
                            <li>Inquiry and communication records</li>
                            <li>Payment information (processed securely by third parties)</li>
                        </ul>
                    </div>
                </div>

                <div class="privacy-card gradient-border reveal">
                    <div class="privacy-card-header">
                        <span class="privacy-number">02</span>
                        <h2>Google Analytics and Cookies</h2>
                    </div>
                    <div class="privacy-card-body">
                        <p>We use Google Analytics to understand how visitors interact with our website. This helps us improve our services and user experience.</p>
                        
                        <h3 class="mt-4"><i class="bi bi-bar-chart-line text-gold me-2"></i>Google Analytics Data Processing:</h3>
                        <ul class="privacy-list">
                            <li><strong>IP Anonymization:</strong> We enable IP anonymization in Google Analytics</li>
                            <li><strong>Data Retention:</strong> Analytics data is retained for 26 months</li>
                            <li><strong>Advertising Features:</strong> We do not use Google Ads remarketing or advertising features</li>
                            <li><strong>Data Sharing:</strong> Analytics data is not shared with other Google products</li>
                        </ul>

                        <div class="gdpr-info-box">
                            <div class="gdpr-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div>
                                <h4>GDPR Compliance</h4>
                                <p class="mb-0">We implement Google's Consent Mode v2 to ensure compliance with GDPR and other privacy regulations. Your consent choices are respected and implemented technically.</p>
                            </div>
                        </div>

                        <h3 class="mt-4"><i class="bi bi-link-45deg text-gold me-2"></i>How Google Uses Information:</h3>
                        <p>To learn more about how Google processes data from websites that use their services, please visit: 
                           <a href="https://www.google.com/policies/privacy/partners/" target="_blank" rel="noopener" class="text-gold">
                               How Google uses information from sites or apps that use our services <i class="bi bi-box-arrow-up-right ms-1"></i>
                           </a>
                        </p>
                    </div>
                </div>

                <div class="privacy-card gradient-border reveal">
                    <div class="privacy-card-header">
                        <span class="privacy-number">03</span>
                        <h2>Cookie Categories</h2>
                    </div>
                    <div class="privacy-card-body">
                        <div class="cookie-category">
                            <div class="cookie-icon essential">
                                <i class="bi bi-gear-fill"></i>
                            </div>
                            <div class="cookie-content">
                                <h4>Essential Cookies <span class="badge-always-active">Always Active</span></h4>
                                <p>These cookies are necessary for the website to function properly. They cannot be disabled.</p>
                                <ul class="privacy-list-inline">
                                    <li>Session management and authentication</li>
                                    <li>Language preferences</li>
                                    <li>Security tokens (CSRF protection)</li>
                                    <li>Cookie consent preferences</li>
                                </ul>
                            </div>
                        </div>

                        <div class="cookie-category">
                            <div class="cookie-icon analytics">
                                <i class="bi bi-graph-up"></i>
                            </div>
                            <div class="cookie-content">
                                <h4>Analytics Cookies <span class="badge-optional">Optional</span></h4>
                                <p>Help us understand website usage and improve user experience.</p>
                                <ul class="privacy-list-inline">
                                    <li>Google Analytics (_ga, _ga_*, _gid)</li>
                                    <li>Page view tracking</li>
                                    <li>User journey analysis (anonymized)</li>
                                    <li>Performance monitoring</li>
                                </ul>
                            </div>
                        </div>

                        <div class="cookie-category">
                            <div class="cookie-icon marketing">
                                <i class="bi bi-megaphone-fill"></i>
                            </div>
                            <div class="cookie-content">
                                <h4>Marketing Cookies <span class="badge-optional">Optional</span></h4>
                                <p>Currently not in use. Reserved for future advertising campaigns.</p>
                                <ul class="privacy-list-inline">
                                    <li>Advertising personalization (if enabled in future)</li>
                                    <li>Conversion tracking (if enabled in future)</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="privacy-card gradient-border reveal">
                    <div class="privacy-card-header">
                        <span class="privacy-number">04</span>
                        <h2>Your Rights (GDPR)</h2>
                    </div>
                    <div class="privacy-card-body">
                        <p>Under GDPR, you have the following rights regarding your personal data:</p>
                        
                        <div class="rights-grid">
                            <div class="right-item">
                                <div class="right-icon"><i class="bi bi-file-earmark-text"></i></div>
                                <h4>Access</h4>
                                <p>Request access to your personal data</p>
                            </div>
                            <div class="right-item">
                                <div class="right-icon"><i class="bi bi-pencil-square"></i></div>
                                <h4>Rectification</h4>
                                <p>Request correction of inaccurate data</p>
                            </div>
                            <div class="right-item">
                                <div class="right-icon"><i class="bi bi-trash3"></i></div>
                                <h4>Erasure</h4>
                                <p>Request deletion of your data</p>
                            </div>
                            <div class="right-item">
                                <div class="right-icon"><i class="bi bi-pause-circle"></i></div>
                                <h4>Restriction</h4>
                                <p>Request restriction of processing</p>
                            </div>
                            <div class="right-item">
                                <div class="right-icon"><i class="bi bi-download"></i></div>
                                <h4>Portability</h4>
                                <p>Receive your data in portable format</p>
                            </div>
                            <div class="right-item">
                                <div class="right-icon"><i class="bi bi-x-octagon"></i></div>
                                <h4>Object</h4>
                                <p>Object to processing of your data</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="privacy-card gradient-border reveal">
                    <div class="privacy-card-header">
                        <span class="privacy-number">05</span>
                        <h2>Contact Information</h2>
                    </div>
                    <div class="privacy-card-body">
                        <p>For privacy-related questions or to exercise your rights, contact us:</p>
                        
                        <div class="contact-info-grid">
                            <div class="contact-info-item">
                                <i class="bi bi-envelope-fill text-gold"></i>
                                <div>
                                    <strong>Email</strong>
                                    <p class="mb-0">privacy@@aristocraticartworksale.com</p>
                                </div>
                            </div>
                            <div class="contact-info-item">
                                <i class="bi bi-building text-gold"></i>
                                <div>
                                    <strong>Data Controller</strong>
                                    <p class="mb-0">Aristocratic Artwork Sale</p>
                                </div>
                            </div>
                            <div class="contact-info-item">
                                <i class="bi bi-clock-fill text-gold"></i>
                                <div>
                                    <strong>Response Time</strong>
                                    <p class="mb-0">We will respond to requests within 30 days</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="privacy-card gradient-border reveal">
                    <div class="privacy-card-header">
                        <span class="privacy-number">06</span>
                        <h2>Changes to This Policy</h2>
                    </div>
                    <div class="privacy-card-body">
                        <p>We may update this privacy policy from time to time. Changes will be posted on this page with an updated revision date. We encourage you to review this policy periodically.</p>
                    </div>
                </div>

                <div class="privacy-footer reveal">
                    <div class="d-flex flex-wrap justify-content-center gap-4">
                        <div class="footer-badge">
                            <i class="bi bi-shield-check me-2"></i>
                            <span>GDPR Compliant</span>
                        </div>
                        <div class="footer-badge">
                            <i class="bi bi-flag me-2"></i>
                            <span>Czech Law Compliant</span>
                        </div>
                        <div class="footer-badge">
                            <i class="bi bi-google me-2"></i>
                            <span>Google ToS Compliant</span>
                        </div>
                    </div>
                    <p class="mt-4 text-muted"><strong>Effective Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Privacy Policy Page - Dark Aristocratic Theme */
.privacy-hero {
    background: linear-gradient(135deg, var(--color-bg-main) 0%, var(--color-primary-deep) 50%, var(--color-bg-main) 100%);
    padding: 4rem 0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.privacy-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 20%, rgba(75, 0, 130, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(212, 175, 55, 0.1) 0%, transparent 50%);
    pointer-events: none;
}

.privacy-hero .hero-title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
}

.privacy-hero .hero-subtitle {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    color: var(--color-gold);
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
}

.updated-date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
}

/* Privacy Cards */
.privacy-card {
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
    overflow: hidden;
}

.privacy-card-header {
    padding: 2rem 2rem 1rem;
    position: relative;
}

.privacy-number {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-gold);
    opacity: 0.2;
}

.privacy-card-header h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-gold);
    margin-bottom: 0.25rem;
}

.privacy-card-body {
    padding: 0 2rem 2rem;
}

.privacy-card-body h3 {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 1rem;
}

.privacy-list {
    list-style: none;
    padding: 0;
}

.privacy-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.6;
}

.privacy-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--color-gold);
    border-radius: 50%;
}

.privacy-list li strong {
    color: var(--color-text-main);
}

/* GDPR Info Box */
.gdpr-info-box {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(75, 0, 130, 0.15), rgba(212, 175, 55, 0.05));
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
}

.gdpr-icon {
    font-size: 2rem;
    color: var(--color-gold);
}

.gdpr-info-box h4 {
    color: var(--color-gold);
    font-size: var(--text-base);
    margin-bottom: 0.5rem;
}

.gdpr-info-box p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
}

/* Cookie Categories */
.cookie-category {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
}

.cookie-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
}

.cookie-icon.essential {
    background: rgba(75, 0, 130, 0.2);
    color: var(--color-primary-light);
}

.cookie-icon.analytics {
    background: rgba(212, 175, 55, 0.15);
    color: var(--color-gold);
}

.cookie-icon.marketing {
    background: rgba(128, 0, 32, 0.15);
    color: var(--color-accent-red);
}

.cookie-content h4 {
    font-size: var(--text-base);
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
}

.badge-always-active {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-left: 0.5rem;
    font-weight: 500;
}

.badge-optional {
    background: rgba(212, 175, 55, 0.15);
    color: var(--color-gold);
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-left: 0.5rem;
    font-weight: 500;
}

.privacy-list-inline {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
}

.privacy-list-inline li {
    background: var(--color-bg-surface);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
}

/* Rights Grid */
.rights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
}

.right-item {
    background: var(--color-bg-elevated);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    text-align: center;
    border: 1px solid var(--color-border);
    transition: all var(--transition-normal);
}

.right-item:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
}

.right-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--color-gold);
}

.right-item h4 {
    color: var(--color-gold);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.right-item p {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin: 0;
}

/* Contact Info */
.contact-info-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
}

.contact-info-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
}

.contact-info-item i {
    font-size: 1.5rem;
}

.contact-info-item strong {
    display: block;
    color: var(--color-text-main);
    font-size: var(--text-sm);
    margin-bottom: 0.25rem;
}

.contact-info-item p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
}

/* Footer */
.privacy-footer {
    background: linear-gradient(135deg, var(--color-primary-deep), var(--color-bg-surface));
    padding: 2rem;
    border-radius: var(--radius-lg);
    text-align: center;
    margin-top: 2rem;
}

.footer-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--color-gold-dim);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    color: var(--color-gold);
    font-size: var(--text-sm);
}

/* Responsive */
@@media (max-width: 768px) {
    .privacy-hero .hero-title {
        font-size: var(--text-3xl);
    }
    
    .privacy-card-header,
    .privacy-card-body {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
    }
    
    .privacy-number {
        display: none;
    }
    
    .cookie-category {
        flex-direction: column;
        gap: 1rem;
    }
    
    .gdpr-info-box {
        flex-direction: column;
        text-align: center;
    }
    
    .rights-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>
