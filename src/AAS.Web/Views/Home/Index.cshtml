@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content" style="display: flex; flex-direction: column; align-items: center;">
    <p class="text-accent text-gold mb-4 animate-fade-in">@L["Slogan"]</p>
    <img src="/images/logo-hero.png" alt="Aristocratic Artwork Sale" class="animate-fade-in delay-1" style="max-width: 350px; max-height: 280px; width: auto; height: auto; margin-bottom: 1.5rem; filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.4));" />
    <div class="hero-divider animate-fade-in delay-2"></div>
    <p class="hero-subtitle animate-fade-in delay-2">
      @L["Home Description"]
    </p>
    <div class="d-flex gap-3 justify-content-center flex-wrap mt-5 animate-fade-in delay-3">
      <a class="btn btn-primary btn-lg" href="/Collections/Landing">@L["Explore collections"]</a>
      <a class="btn btn-outline-secondary btn-lg" href="/Contacts">@L["Contact Us"]</a>
    </div>
  </div>
</section>

<!-- Buy or Sell Section -->
<section class="section section-dark">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-5 mb-lg-0">
        <p class="text-accent text-gold mb-3">@L["BuyOrSellThroughUs"]</p>
        <h2 class="mb-4" style="font-size: var(--text-4xl);">@L["BuyOrSellDescription"]</h2>
        <p class="lead text-muted mb-4">@L["BuyOrSellDetails"]</p>
        <a href="/HowTo" class="btn btn-primary">
          <i class="bi bi-arrow-right me-2"></i>@L["LearnMore"]
        </a>
      </div>
      <div class="col-lg-6">
        <div class="card-glass p-5 text-center">
          <div class="mb-4">
            <i class="bi bi-shield-check" style="font-size: 64px; color: var(--color-gold);"></i>
          </div>
          <h3 class="mb-3">@L["WhatIsAASVerified"]</h3>
          <p class="text-muted">@L["AASVerifiedExplanation"]</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why Choose Us Section -->
<section class="section">
  <div class="container">
    <div class="text-center mb-5">
      <p class="text-accent text-gold mb-3">@L["Excellence in Every Transaction"]</p>
      <h2>@L["Why Choose Us"]</h2>
    </div>
    
    <div class="row g-4">
      <div class="col-12 col-md-4">
        <div class="card h-100">
          <div class="card-body text-center p-4">
            <div class="mb-4">
              <i class="bi bi-cash-stack" style="font-size: 48px; color: var(--color-gold);"></i>
            </div>
            <h4 class="card-title mb-3">@L["Highest Prices"]</h4>
            <p class="card-text text-muted">@L["Highest Prices Desc"]</p>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="card h-100">
          <div class="card-body text-center p-4">
            <div class="mb-4">
              <i class="bi bi-shield-lock" style="font-size: 48px; color: var(--color-gold);"></i>
            </div>
            <h4 class="card-title mb-3">@L["Complete Discretion"]</h4>
            <p class="card-text text-muted">@L["Complete Discretion Desc"]</p>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="card h-100">
          <div class="card-body text-center p-4">
            <div class="mb-4">
              <i class="bi bi-award" style="font-size: 48px; color: var(--color-gold);"></i>
            </div>
            <h4 class="card-title mb-3">@L["Expert Service"]</h4>
            <p class="card-text text-muted">@L["Expert Service Desc"]</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Categories Preview Section -->
<section class="section section-dark">
  <div class="container">
    <div class="text-center mb-5">
      <p class="text-accent text-gold mb-3">@L["Browse"]</p>
      <h2>@L["Explore collections"]</h2>
    </div>
    
    <div class="row g-4 justify-content-center">
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/Collections?category=Paintings" class="card text-center text-decoration-none h-100">
          <div class="card-body p-4">
            <i class="bi bi-palette mb-3" style="font-size: 36px; color: var(--color-primary-light);"></i>
            <h6 class="mb-0">@L["Paintings"]</h6>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/Collections?category=Jewelry" class="card text-center text-decoration-none h-100">
          <div class="card-body p-4">
            <i class="bi bi-gem mb-3" style="font-size: 36px; color: var(--color-primary-light);"></i>
            <h6 class="mb-0">@L["Jewelry"]</h6>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/Collections?category=Watches" class="card text-center text-decoration-none h-100">
          <div class="card-body p-4">
            <i class="bi bi-stopwatch mb-3" style="font-size: 36px; color: var(--color-primary-light);"></i>
            <h6 class="mb-0">@L["Watches"]</h6>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/Collections?category=Statues" class="card text-center text-decoration-none h-100">
          <div class="card-body p-4">
            <i class="bi bi-person-bounding-box mb-3" style="font-size: 36px; color: var(--color-primary-light);"></i>
            <h6 class="mb-0">@L["Statues"]</h6>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/Collections?category=Other" class="card text-center text-decoration-none h-100">
          <div class="card-body p-4">
            <i class="bi bi-stars mb-3" style="font-size: 36px; color: var(--color-primary-light);"></i>
            <h6 class="mb-0">@L["Decorative Arts"]</h6>
          </div>
        </a>
      </div>
    </div>
    
    <div class="text-center mt-5">
      <a href="/Collections/Landing" class="btn btn-primary btn-lg">
        @L["ViewAllCollections"] <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </div>
  </div>
</section>
