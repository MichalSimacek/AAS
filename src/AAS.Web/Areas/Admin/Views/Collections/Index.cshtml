@model IEnumerable<AAS.Web.Models.Collection>
@{
    ViewData["Title"] = "Manage Collections";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px;">
        <strong><i class="bi bi-check-circle me-2"></i>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-collections-page">
    <div class="container-fluid px-4 py-4">
        <!-- Header with Actions -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-left">
                    <h1 class="page-title">
                        <i class="bi bi-grid-3x3 me-2"></i>Collections Management
                    </h1>
                    <p class="page-subtitle">
                        <span class="badge bg-primary me-2">@Model.Count() Total</span>
                        <span class="badge bg-success me-2">@Model.Count(c => c.Status == AAS.Web.Models.CollectionStatus.Available) Available</span>
                        <span class="badge bg-warning me-2">@Model.Count(c => c.Status == AAS.Web.Models.CollectionStatus.InAuction) In Auction</span>
                        <span class="badge bg-danger">@Model.Count(c => c.Status == AAS.Web.Models.CollectionStatus.Sold) Sold</span>
                    </p>
                </div>
                <div class="header-actions">
                    <a href="/Admin/Dashboard" class="btn btn-outline-secondary">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                    <a href="/Admin/Collections/Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Create New Collection
                    </a>
                </div>
            </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="filters-section">
            <form method="get" class="filters-form">
                <div class="filters-row">
                    <!-- Search Box -->
                    <div class="filter-group search-group">
                        <label for="search" class="filter-label">
                            <i class="bi bi-search me-1"></i>Search
                        </label>
                        <input type="text" 
                               id="search" 
                               name="search" 
                               value="@ViewBag.Search" 
                               placeholder="Title or description..." 
                               class="form-control search-input">
                    </div>

                    <!-- Status Filter -->
                    <div class="filter-group">
                        <label for="status" class="filter-label">
                            <i class="bi bi-flag me-1"></i>Status
                        </label>
                        <select id="status" name="status" class="form-select">
                            <option value="">All Statuses</option>
                            @{
                                var statusSelected0 = ViewBag.Status?.Equals(0) == true;
                                var statusSelected1 = ViewBag.Status?.Equals(1) == true;
                                var statusSelected2 = ViewBag.Status?.Equals(2) == true;
                            }
                            @if (statusSelected0)
                            {
                                <option value="0" selected>Available</option>
                            }
                            else
                            {
                                <option value="0">Available</option>
                            }
                            @if (statusSelected1)
                            {
                                <option value="1" selected>Sold</option>
                            }
                            else
                            {
                                <option value="1">Sold</option>
                            }
                            @if (statusSelected2)
                            {
                                <option value="2" selected>In Auction</option>
                            }
                            else
                            {
                                <option value="2">In Auction</option>
                            }
                        </select>
                    </div>

                    <!-- Category Filter -->
                    <div class="filter-group">
                        <label for="category" class="filter-label">
                            <i class="bi bi-tag me-1"></i>Category
                        </label>
                        <select id="category" name="category" class="form-select">
                            <option value="">All Categories</option>
                            @{
                                var categoryOptions = new Dictionary<int, string> {
                                    {0, "Paintings"}, {1, "Jewelry"}, {2, "Watches"}, {3, "Statues"}, {4, "Other"}
                                };
                            }
                            @foreach (var option in categoryOptions)
                            {
                                @if (ViewBag.Category?.Equals(option.Key) == true)
                                {
                                    <option value="@option.Key" selected>@option.Value</option>
                                }
                                else
                                {
                                    <option value="@option.Key">@option.Value</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="bi bi-currency-euro me-1"></i>Price Range
                        </label>
                        <div class="price-range-inputs">
                            <input type="number" 
                                   name="minPrice" 
                                   value="@ViewBag.MinPrice" 
                                   placeholder="Min €" 
                                   class="form-control price-input"
                                   min="0"
                                   step="1">
                            <span class="price-separator">-</span>
                            <input type="number" 
                                   name="maxPrice" 
                                   value="@ViewBag.MaxPrice" 
                                   placeholder="Max €" 
                                   class="form-control price-input"
                                   min="0"
                                   step="1">
                        </div>
                    </div>

                    <!-- Verified Filter -->
                    <div class="filter-group">
                        <label for="verified" class="filter-label">
                            <i class="bi bi-patch-check me-1"></i>Verified
                        </label>
                        <select id="verified" name="verified" class="form-select">
                            <option value="">All Items</option>
                            @if (ViewBag.Verified?.Equals(true) == true)
                            {
                                <option value="true" selected>Verified Only</option>
                            }
                            else
                            {
                                <option value="true">Verified Only</option>
                            }
                            @if (ViewBag.Verified?.Equals(false) == true)
                            {
                                <option value="false" selected>Unverified Only</option>
                            }
                            else
                            {
                                <option value="false">Unverified Only</option>
                            }
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary filter-btn">
                            <i class="bi bi-funnel me-1"></i>Filter
                        </button>
                        <a href="/Admin/Collections" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise me-1"></i>Reset
                        </a>
                    </div>
                </div>

                <!-- Results Summary -->
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string) || 
                     ViewBag.Status != null || ViewBag.Category != null || 
                     ViewBag.MinPrice != null || ViewBag.MaxPrice != null || 
                     ViewBag.Verified != null)
                {
                    <div class="results-summary">
                        <span class="results-count">
                            <i class="bi bi-info-circle me-1"></i>
                            Showing @ViewBag.FilteredCount results
                            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                            {
                                <span class="filter-tag">Search: "@ViewBag.Search"</span>
                            }
                            @if (ViewBag.Status != null)
                            {
                                <span class="filter-tag">Status: @((AAS.Web.Models.CollectionStatus)ViewBag.Status)</span>
                            }
                            @if (ViewBag.Category != null)
                            {
                                <span class="filter-tag">Category: @((AAS.Web.Models.CollectionCategory)ViewBag.Category)</span>
                            }
                            @if (ViewBag.MinPrice != null || ViewBag.MaxPrice != null)
                            {
                                <span class="filter-tag">
                                    Price: @(ViewBag.MinPrice?.ToString() ?? "0")€ - @(ViewBag.MaxPrice?.ToString() ?? "∞")€
                                </span>
                            }
                            @if (ViewBag.Verified != null)
                            {
                                <span class="filter-tag">@(ViewBag.Verified == true ? "Verified" : "Unverified")</span>
                            }
                        </span>
                    </div>
                }
            </form>
        </div>

        <!-- Collections List -->
        @if (!Model.Any())
        {
            <div class="empty-state-card">
                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <h3>No Collections Yet</h3>
                <p>Start by creating your first collection</p>
                <a href="/Admin/Collections/Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle me-2"></i>Create First Collection
                </a>
            </div>
        }
        else
        {
            <div class="collections-table-card">
                <table class="table collections-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Title & Details</th>
                            <th style="width: 120px;">Status</th>
                            <th style="width: 150px;">Price</th>
                            <th style="width: 100px;">Images</th>
                            <th style="width: 120px;">Created</th>
                            <th style="width: 180px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var collection in Model.OrderBy(c => c.Status).ThenByDescending(c => c.CreatedUtc))
                        {
                            var firstImage = collection.Images?.OrderBy(i => i.SortOrder).FirstOrDefault();
                            var imageCount = collection.Images?.Count() ?? 0;
                            
                            <tr class="collection-row">
                                <td>
                                    @if (firstImage != null)
                                    {
                                        <img src="/uploads/images/@firstImage.FileName-480.jpg" 
                                             alt="@collection.Title" 
                                             class="collection-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="collection-thumbnail-placeholder">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="collection-info">
                                        <h5 class="collection-name">@collection.Title</h5>
                                        <div class="collection-badges">
                                            <span class="badge-category">@collection.Category</span>
                                            @if (collection.AASVerified)
                                            {
                                                <span class="badge-verified" title="AAS Verified">
                                                    <i class="bi bi-patch-check-fill"></i> Verified
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge status-@collection.Status.ToString().ToLower()">
                                        @if (collection.Status == AAS.Web.Models.CollectionStatus.Available)
                                        {
                                            <i class="bi bi-check-circle"></i>
                                        }
                                        else if (collection.Status == AAS.Web.Models.CollectionStatus.InAuction)
                                        {
                                            <i class="bi bi-megaphone"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle"></i>
                                        }
                                        @collection.Status
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(collection.Price))
                                    {
                                        <span class="collection-price">
                                            @{
                                                if (decimal.TryParse(collection.Price, out decimal pval))
                                                {
                                                    @((collection.Currency == AAS.Web.Models.Currency.EUR ? "€" : "$") + string.Format("{0:N0}", pval))
                                                }
                                                else
                                                {
                                                    @collection.Price
                                                }
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="image-count">
                                        <i class="bi bi-images me-1"></i>@imageCount
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@collection.CreatedUtc.ToString("dd.MM.yyyy")</span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/collection/@collection.Slug" 
                                           class="btn-action btn-view" 
                                           target="_blank"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Admin/Collections/Edit/@collection.Id" 
                                           class="btn-action btn-edit"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn-action btn-delete delete-btn" 
                                                data-id="@collection.Id" 
                                                data-title="@collection.Title"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
/* Admin Collections Page */
.admin-collections-page {
    background: #F8F9FA;
    min-height: 100vh;
}

.page-header {
    background: white;
    border-bottom: 1px solid #E5E5E5;
    padding: 24px 0;
    margin-bottom: 24px;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
}

.page-title {
    font-size: 28px;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0;
    font-family: 'Playfair Display', serif;
}

.page-subtitle {
    margin: 8px 0 0 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.header-actions {
    display: flex;
    gap: 12px;
}

/* Empty State */
.empty-state-card {
    background: white;
    border-radius: 12px;
    padding: 60px 40px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.empty-icon {
    font-size: 64px;
    color: #B8941F;
    margin-bottom: 20px;
    opacity: 0.5;
}

.empty-state-card h3 {
    font-size: 24px;
    color: #1A1A1A;
    margin-bottom: 12px;
}

.empty-state-card p {
    color: #6c757d;
    margin-bottom: 24px;
}

/* Collections Table */
.collections-table-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    overflow: hidden;
}

.collections-table {
    margin: 0;
    width: 100%;
}

.collections-table thead th {
    background: #F8F9FA;
    border-bottom: 2px solid #E5E5E5;
    padding: 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: #6c757d;
    letter-spacing: 0.5px;
}

.collections-table tbody tr {
    border-bottom: 1px solid #E5E5E5;
    transition: background 0.2s ease;
}

.collections-table tbody tr:hover {
    background: #F8F9FA;
}

.collections-table td {
    padding: 16px;
    vertical-align: middle;
}

.collection-thumbnail {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #E5E5E5;
}

.collection-thumbnail-placeholder {
    width: 50px;
    height: 50px;
    background: #F8F9FA;
    border-radius: 8px;
    border: 1px solid #E5E5E5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6c757d;
    font-size: 20px;
}

.collection-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.collection-name {
    font-size: 16px;
    font-weight: 600;
    color: #1A1A1A;
    margin: 0;
    line-height: 1.3;
}

.collection-badges {
    display: flex;
    gap: 8px;
    align-items: center;
}

.badge-category {
    padding: 4px 10px;
    background: #F8F9FA;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #6c757d;
    text-transform: uppercase;
}

.badge-verified {
    padding: 4px 8px;
    background: #E8F5E9;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #2E7D32;
}

.status-badge {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.status-available {
    background: #E8F5E9;
    color: #2E7D32;
}

.status-inauction {
    background: #FFF3E0;
    color: #EF6C00;
}

.status-sold {
    background: #FCE4EC;
    color: #C2185B;
}

.collection-price {
    font-size: 16px;
    font-weight: 700;
    color: #B8941F;
}

.image-count {
    font-size: 14px;
    color: #6c757d;
}

.action-buttons {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.btn-action {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    border: 1px solid #E5E5E5;
    background: white;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.btn-view:hover {
    background: #E3F2FD;
    border-color: #1976D2;
    color: #1976D2;
}

.btn-edit:hover {
    background: #FFF3E0;
    border-color: #EF6C00;
    color: #EF6C00;
}

.btn-delete:hover {
    background: #FCE4EC;
    border-color: #C2185B;
    color: #C2185B;
}

@@media (max-width: 1200px) {
    .collections-table {
        display: block;
        overflow-x: auto;
    }
}

@@media (max-width: 768px) {
    .header-content {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .header-actions {
        width: 100%;
    }
    
    .header-actions .btn {
        flex: 1;
    }
}

/* Search and Filter Section */
.filters-section {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    margin-bottom: 24px;
    padding: 24px;
}

.filters-form {
    margin: 0;
}

.filters-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr 1fr auto;
    gap: 20px;
    align-items: end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.search-group {
    min-width: 250px;
}

.filter-label {
    font-size: 12px;
    font-weight: 600;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
    display: flex;
    align-items: center;
}

.search-input,
.form-select,
.price-input {
    border: 1px solid #E5E5E5;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-input:focus,
.form-select:focus,
.price-input:focus {
    border-color: #B8941F;
    box-shadow: 0 0 0 3px rgba(184, 148, 31, 0.1);
    outline: none;
}

.price-range-inputs {
    display: flex;
    align-items: center;
    gap: 8px;
}

.price-input {
    flex: 1;
    min-width: 80px;
}

.price-separator {
    color: #6c757d;
    font-weight: 500;
}

.filter-actions {
    display: flex;
    gap: 8px;
}

.filter-btn {
    background: #B8941F;
    border-color: #B8941F;
    padding: 10px 20px;
    font-weight: 600;
}

.filter-btn:hover {
    background: #A0821B;
    border-color: #A0821B;
}

.results-summary {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #E5E5E5;
}

.results-count {
    font-size: 14px;
    color: #6c757d;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.filter-tag {
    background: #F8F9FA;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
    color: #495057;
}

/* Responsive Design for Filters */
@@media (max-width: 1400px) {
    .filters-row {
        grid-template-columns: 2fr 1fr 1fr 1.5fr auto;
        gap: 16px;
    }
    
    .filter-group:nth-child(5) {
        grid-column: 1 / -1;
        margin-top: 8px;
    }
}

@@media (max-width: 1200px) {
    .filters-row {
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    
    .search-group {
        grid-column: 1 / -1;
        min-width: auto;
    }
    
    .filter-actions {
        grid-column: 1 / -1;
        justify-content: flex-start;
        margin-top: 8px;
    }
}

@@media (max-width: 768px) {
    .filters-section {
        padding: 16px;
        margin-bottom: 16px;
    }
    
    .filters-row {
        grid-template-columns: 1fr;
        gap: 16px;
    }
    
    .filter-actions {
        flex-direction: column;
    }
    
    .filter-actions .btn {
        width: 100%;
    }
    
    .results-summary {
        margin-top: 16px;
        padding-top: 16px;
    }
    
    .results-count {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
}
</style>

<!-- Delete Confirmation Modal - Simple Implementation -->
<div id="deleteModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1055; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 12px; max-width: 500px; width: 90%; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
        <div style="padding: 24px; border-bottom: 1px solid #E5E5E5; display: flex; justify-content: space-between; align-items: center;">
            <h5 style="margin: 0; font-size: 20px; color: #1A1A1A;"><i class="bi bi-exclamation-triangle me-2" style="color: #DC3545;"></i>Confirm Delete</h5>
            <button type="button" onclick="closeDeleteModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; padding: 0; width: 30px; height: 30px; color: #4A4A4A;">&times;</button>
        </div>
        <div style="padding: 24px;">
            <p style="margin-bottom: 12px; color: #1A1A1A;">Are you sure you want to delete this collection?</p>
            <p style="margin-bottom: 12px;"><strong id="deleteCollectionTitle"></strong></p>
            <p style="margin: 0; color: #DC3545; font-size: 14px;"><i class="bi bi-exclamation-triangle me-1"></i> This action cannot be undone.</p>
        </div>
        <div style="padding: 24px; border-top: 1px solid #E5E5E5; display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <form id="deleteForm" method="post" style="display: inline; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        </div>
    </div>
</div>

<script>
function closeDeleteModal() {
    document.getElementById('deleteModal').style.display = 'none';
    document.body.style.overflow = '';
}

function openDeleteModal(id, title) {
    document.getElementById('deleteCollectionTitle').textContent = title;
    document.getElementById('deleteForm').action = '/Admin/Collections/Delete/' + id;
    document.getElementById('deleteModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

// Close on ESC
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeDeleteModal();
    }
});

// Close on backdrop click
document.getElementById('deleteModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeDeleteModal();
    }
});

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.delete-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.getAttribute('data-id');
            var title = this.getAttribute('data-title');
            openDeleteModal(id, title);
        });
    });

    // Enhanced filtering functionality
    const searchInput = document.getElementById('search');
    const filtersForm = document.querySelector('.filters-form');
    let searchTimeout;

    // Live search with debounce
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                if (this.value.length >= 2 || this.value.length === 0) {
                    submitFilters();
                }
            }, 500);
        });

        // Submit on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitFilters();
            }
        });
    }

    // Auto-submit on filter change
    const filterSelects = document.querySelectorAll('.filters-form select');
    const priceInputs = document.querySelectorAll('.price-input');

    filterSelects.forEach(select => {
        select.addEventListener('change', function() {
            submitFilters();
        });
    });

    priceInputs.forEach(input => {
        input.addEventListener('blur', function() {
            if (this.value !== this.dataset.originalValue) {
                submitFilters();
            }
        });

        // Store original value for comparison
        input.dataset.originalValue = input.value || '';

        // Submit on Enter
        input.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitFilters();
            }
        });
    });

    function submitFilters() {
        // Add loading state
        const filterBtn = document.querySelector('.filter-btn');
        if (filterBtn) {
            filterBtn.disabled = true;
            filterBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Filtering...';
        }

        // Submit form
        filtersForm.submit();
    }

    // Clear filters functionality
    const resetBtn = document.querySelector('.btn[href="/Admin/Collections"]');
    if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Clear all form inputs
            searchInput.value = '';
            filterSelects.forEach(select => select.selectedIndex = 0);
            priceInputs.forEach(input => input.value = '');
            
            // Redirect to clean URL
            window.location.href = '/Admin/Collections';
        });
    }

    // URL highlighting for filtered state
    const urlParams = new URLSearchParams(window.location.search);
    const hasFilters = urlParams.toString().length > 0;
    
    if (hasFilters) {
        const filtersSection = document.querySelector('.filters-section');
        if (filtersSection) {
            filtersSection.style.borderLeft = '4px solid #B8941F';
        }
    }
});
</script>
