@model IEnumerable<AAS.Web.Models.Collection>
@{
    ViewData["Title"] = "Manage Collections";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px;">
        <strong><i class="bi bi-check-circle me-2"></i>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-collections-page">
    <div class="container-fluid px-4 py-4">
        <!-- Header with Actions -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-left">
                    <h1 class="page-title">
                        <i class="bi bi-grid-3x3 me-2"></i>Collections Management
                    </h1>
                    <p class="page-subtitle">
                        <span class="badge bg-primary me-2">@Model.Count() Total</span>
                        <span class="badge bg-success me-2">@Model.Count(c => c.Status == AAS.Web.Models.CollectionStatus.Available) Available</span>
                        <span class="badge bg-warning me-2">@Model.Count(c => c.Status == AAS.Web.Models.CollectionStatus.InAuction) In Auction</span>
                        <span class="badge bg-danger">@Model.Count(c => c.Status == AAS.Web.Models.CollectionStatus.Sold) Sold</span>
                    </p>
                </div>
                <div class="header-actions">
                    <a href="/Admin/Dashboard" class="btn btn-outline-secondary">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                    <a href="/Admin/Collections/Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Create New Collection
                    </a>
                </div>
            </div>
        </div>

        <!-- Collections List -->
        @if (!Model.Any())
        {
            <div class="empty-state-card">
                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <h3>No Collections Yet</h3>
                <p>Start by creating your first collection</p>
                <a href="/Admin/Collections/Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle me-2"></i>Create First Collection
                </a>
            </div>
        }
        else
        {
            <div class="collections-table-card">
                <table class="table collections-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Title & Details</th>
                            <th style="width: 120px;">Status</th>
                            <th style="width: 150px;">Price</th>
                            <th style="width: 100px;">Images</th>
                            <th style="width: 120px;">Created</th>
                            <th style="width: 180px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var collection in Model.OrderBy(c => c.Status).ThenByDescending(c => c.CreatedUtc))
                        {
                            var firstImage = collection.Images?.OrderBy(i => i.SortOrder).FirstOrDefault();
                            var imageCount = collection.Images?.Count() ?? 0;
                            
                            <tr class="collection-row">
                                <td>
                                    @if (firstImage != null)
                                    {
                                        <img src="/uploads/images/@firstImage.FileName-480.jpg" 
                                             alt="@collection.Title" 
                                             class="collection-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="collection-thumbnail-placeholder">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="collection-info">
                                        <h5 class="collection-name">@collection.Title</h5>
                                        <div class="collection-badges">
                                            <span class="badge-category">@collection.Category</span>
                                            @if (collection.AASVerified)
                                            {
                                                <span class="badge-verified" title="AAS Verified">
                                                    <i class="bi bi-patch-check-fill"></i> Verified
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge status-@collection.Status.ToString().ToLower()">
                                        @if (collection.Status == AAS.Web.Models.CollectionStatus.Available)
                                        {
                                            <i class="bi bi-check-circle"></i>
                                        }
                                        else if (collection.Status == AAS.Web.Models.CollectionStatus.InAuction)
                                        {
                                            <i class="bi bi-megaphone"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle"></i>
                                        }
                                        @collection.Status
                                    </span>
                                </td>
                                <td>
                                    @if (collection.Price.HasValue)
                                    {
                                        <span class="collection-price">
                                            @(collection.Currency == AAS.Web.Models.Currency.EUR ? "€" : "$")@string.Format("{0:N0}", collection.Price)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="image-count">
                                        <i class="bi bi-images me-1"></i>@imageCount
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@collection.CreatedUtc.ToString("dd.MM.yyyy")</span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/collections/@collection.Slug" 
                                           class="btn-action btn-view" 
                                           target="_blank"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Admin/Collections/Edit/@collection.Id" 
                                           class="btn-action btn-edit"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn-action btn-delete delete-btn" 
                                                data-id="@collection.Id" 
                                                data-title="@collection.Title"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
.admin-header {
    margin-bottom: 3rem;
}

/* Baroque ornamental divider */
.ornament-divider {
    height: 3px;
    background: linear-gradient(90deg, transparent, #C9A961, transparent);
    margin: 2rem 0;
    border-radius: 2px;
    opacity: 0.3;
}

.ornament-divider-small {
    height: 1px;
    background: #E5E5E5;
    margin-bottom: 1rem;
}

.empty-state {
    text-align: center;
    padding: 5rem 2rem;
    background: #FAFAFA;
    border: 2px dashed #E5E5E5;
    border-radius: 8px;
    margin: 3rem 0;
}

.empty-state-icon {
    font-size: 4rem;
    color: #C9A961;
    margin-bottom: 1rem;
    opacity: 0.4;
}

.empty-state h3 {
    color: #1A1A1A;
    font-family: 'Playfair Display', serif;
    margin-bottom: 0.5rem;
}

.empty-state p {
    color: #6B6B6B;
    margin-bottom: 0;
}

.collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.collection-card {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    padding: 1.75rem;
    transition: all 0.3s ease;
}

.collection-card:hover {
    transform: translateY(-4px);
    border-color: #C9A961;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
}

.collection-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
}

.collection-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: #1A1A1A;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.collection-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.badge-gold {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(201, 169, 97, 0.1);
    border: 1px solid rgba(201, 169, 97, 0.2);
    color: #B8941F;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    border-radius: 3px;
}

.collection-description {
    color: #4A4A4A;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.collection-actions {
    display: flex;
    gap: 0.5rem;
}

.collection-footer {
    margin-top: 1rem;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
}

@@media (max-width: 768px) {
    .collections-grid {
        grid-template-columns: 1fr;
    }

    .collection-card-header {
        flex-direction: column;
    }

    .collection-actions {
        width: 100%;
    }

    .collection-actions .btn {
        flex: 1;
    }
}
</style>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this collection?</p>
                <p><strong id="deleteCollectionTitle"></strong></p>
                <p class="text-danger small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.delete-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.getAttribute('data-id');
            var title = this.getAttribute('data-title');
            document.getElementById('deleteCollectionTitle').textContent = title;
            document.getElementById('deleteForm').action = '/Admin/Collections/Delete/' + id;
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        });
    });
});
</script>
