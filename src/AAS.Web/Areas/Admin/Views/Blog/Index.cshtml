@model IEnumerable<AAS.Web.Models.BlogPost>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L

@{
    ViewData["Title"] = L["Blog"];
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px;">
        <strong><i class="bi bi-check-circle me-2"></i>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin: 20px;">
        <strong><i class="bi bi-exclamation-triangle me-2"></i>Error!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-blog-page">
    <div class="container-fluid px-4 py-4">
        <!-- Header with Actions -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-left">
                    <h1 class="page-title">
                        <i class="bi bi-journal-text me-2"></i>Blog Management
                    </h1>
                    <p class="page-subtitle">
                        <span class="badge bg-primary me-2">@Model.Count() Total</span>
                        <span class="badge bg-success me-2">@Model.Count(p => p.Published) Published</span>
                        <span class="badge bg-secondary">@Model.Count(p => !p.Published) Drafts</span>
                    </p>
                </div>
                <div class="header-actions">
                    <a href="/Admin/Dashboard" class="btn btn-outline-secondary">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                    <a href="/Admin/Blog/Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Create New Post
                    </a>
                </div>
            </div>
        </div>

        <!-- Blog Posts List -->
        @if (!Model.Any())
        {
            <div class="empty-state-card">
                <div class="empty-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h3>No Blog Posts Yet</h3>
                <p>Start by creating your first blog post</p>
                <a href="/Admin/Blog/Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle me-2"></i>Create First Post
                </a>
            </div>
        }
        else
        {
            <div class="blog-table-card">
                <table class="table blog-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Title & Details</th>
                            <th style="width: 120px;">Status</th>
                            <th style="width: 150px;">Author</th>
                            <th style="width: 120px;">Created</th>
                            <th style="width: 180px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.OrderByDescending(p => p.CreatedAt))
                        {
                            <tr class="blog-row">
                                <td>
                                    @if (!string.IsNullOrEmpty(post.FeaturedImage))
                                    {
                                        <img src="@post.FeaturedImage" 
                                             alt="@post.TitleCs" 
                                             class="post-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="post-thumbnail-placeholder">
                                            <i class="bi bi-journal-text"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="post-info">
                                        <h5 class="post-title">@post.TitleCs</h5>
                                        <div class="post-meta">
                                            @if (!string.IsNullOrEmpty(post.FeaturedImage))
                                            {
                                                <span class="badge-feature">
                                                    <i class="bi bi-image"></i> Featured Image
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (post.Published)
                                    {
                                        <span class="status-badge status-published">
                                            <i class="bi bi-check-circle"></i> Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-draft">
                                            <i class="bi bi-pencil-square"></i> Draft
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">Admin</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@post.CreatedAt.ToString("dd.MM.yyyy")<br/>@post.CreatedAt.ToString("HH:mm")</span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/Blog/Post/@post.Id" 
                                           class="btn-action btn-view" 
                                           target="_blank"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Admin/Blog/Edit/@post.Id" 
                                           class="btn-action btn-edit"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn-action btn-delete delete-btn" 
                                                data-id="@post.Id" 
                                                data-title="@post.TitleCs"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
/* Admin Blog Page */
.admin-blog-page {
    background: #F8F9FA;
    min-height: 100vh;
}

.page-header {
    background: white;
    border-bottom: 1px solid #E5E5E5;
    padding: 24px 0;
    margin-bottom: 24px;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
}

.page-title {
    font-size: 28px;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0;
    font-family: 'Playfair Display', serif;
}

.page-subtitle {
    margin: 8px 0 0 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.header-actions {
    display: flex;
    gap: 12px;
}

/* Empty State */
.empty-state-card {
    background: white;
    border-radius: 12px;
    padding: 60px 40px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.empty-icon {
    font-size: 64px;
    color: #B8941F;
    margin-bottom: 20px;
    opacity: 0.5;
}

.empty-state-card h3 {
    font-size: 24px;
    color: #1A1A1A;
    margin-bottom: 12px;
}

.empty-state-card p {
    color: #6c757d;
    margin-bottom: 24px;
}

/* Blog Table */
.blog-table-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    overflow: hidden;
}

.blog-table {
    margin: 0;
    width: 100%;
}

.blog-table thead th {
    background: #F8F9FA;
    border-bottom: 2px solid #E5E5E5;
    padding: 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: #6c757d;
    letter-spacing: 0.5px;
}

.blog-table tbody tr {
    border-bottom: 1px solid #E5E5E5;
    transition: background 0.2s ease;
}

.blog-table tbody tr:hover {
    background: #F8F9FA;
}

.blog-table td {
    padding: 16px;
    vertical-align: middle;
}

.post-thumbnail {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #E5E5E5;
}

.post-thumbnail-placeholder {
    width: 50px;
    height: 50px;
    background: #F8F9FA;
    border-radius: 8px;
    border: 1px solid #E5E5E5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6c757d;
    font-size: 20px;
}

.post-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.post-title {
    font-size: 16px;
    font-weight: 600;
    color: #1A1A1A;
    margin: 0;
    line-height: 1.3;
}

.post-meta {
    display: flex;
    gap: 8px;
    align-items: center;
}

.badge-feature {
    padding: 4px 10px;
    background: #E3F2FD;
    border: 1px solid #90CAF9;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #1976D2;
}

.status-badge {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.status-published {
    background: #E8F5E9;
    color: #2E7D32;
}

.status-draft {
    background: #F5F5F5;
    color: #616161;
}

.action-buttons {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.btn-action {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    border: 1px solid #E5E5E5;
    background: white;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.btn-view:hover {
    background: #E3F2FD;
    border-color: #1976D2;
    color: #1976D2;
}

.btn-edit:hover {
    background: #FFF3E0;
    border-color: #EF6C00;
    color: #EF6C00;
}

.btn-delete:hover {
    background: #FCE4EC;
    border-color: #C2185B;
    color: #C2185B;
}

@media (max-width: 1200px) {
    .blog-table {
        display: block;
        overflow-x: auto;
    }
}

@media (max-width: 768px) {
    .header-content {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .header-actions {
        width: 100%;
    }
    
    .header-actions .btn {
        flex: 1;
    }
}
</style>

<!-- Delete Confirmation Modal - Simple Implementation -->
<div id="deleteModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1055; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 12px; max-width: 500px; width: 90%; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
        <div style="padding: 24px; border-bottom: 1px solid #E5E5E5; display: flex; justify-content: space-between; align-items: center;">
            <h5 style="margin: 0; font-size: 20px; color: #1A1A1A;"><i class="bi bi-exclamation-triangle me-2" style="color: #DC3545;"></i>Confirm Delete</h5>
            <button type="button" onclick="closeDeleteModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; padding: 0; width: 30px; height: 30px; color: #4A4A4A;">&times;</button>
        </div>
        <div style="padding: 24px;">
            <p style="margin-bottom: 12px; color: #1A1A1A;">Are you sure you want to delete this blog post?</p>
            <p style="margin-bottom: 12px;"><strong id="deletePostTitle"></strong></p>
            <p style="margin: 0; color: #DC3545; font-size: 14px;"><i class="bi bi-exclamation-triangle me-1"></i> This action cannot be undone.</p>
        </div>
        <div style="padding: 24px; border-top: 1px solid #E5E5E5; display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <form id="deleteForm" method="post" style="display: inline; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        </div>
    </div>
</div>

<script>
function closeDeleteModal() {
    document.getElementById('deleteModal').style.display = 'none';
    document.body.style.overflow = '';
}

function openDeleteModal(id, title) {
    document.getElementById('deletePostTitle').textContent = title;
    document.getElementById('deleteForm').action = '/Admin/Blog/Delete/' + id;
    document.getElementById('deleteModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

// Close on ESC
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeDeleteModal();
    }
});

// Close on backdrop click
document.getElementById('deleteModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeDeleteModal();
    }
});

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.delete-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.getAttribute('data-id');
            var title = this.getAttribute('data-title');
            openDeleteModal(id, title);
        });
    });
});
</script>
