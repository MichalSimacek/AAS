@model AAS.Web.Models.BlogPost
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L

@{
    ViewData["Title"] = L["Create Blog Post"];
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">@L["Create Blog Post"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Back to Blog"]</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label asp-for="TitleCs" class="form-label">@L["Blog Title"] (Čeština)</label>
                    <input asp-for="TitleCs" class="form-control" required />
                    <span asp-validation-for="TitleCs" class="text-danger"></span>
                    <small class="form-text text-muted">@L["Other languages will be translated automatically using DeepL"]</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["Blog Content"] (Čeština)</label>
                    <div id="tinymce-content" style="min-height: 500px;"></div>
                    <input type="hidden" asp-for="ContentCs" id="ContentCs" />
                    <span asp-validation-for="ContentCs" class="text-danger"></span>
                    <small class="form-text text-muted">@L["Content will be automatically translated to all supported languages"]</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["Featured Image"]</label>
                    <input type="file" name="featuredImage" class="form-control" accept="image/*" />
                    <small class="form-text text-muted">@L["Optional: Main image for the blog post"]</small>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Published" class="form-check-input" type="checkbox" />
                    <label asp-for="Published" class="form-check-label">@L["Published"]</label>
                    <small class="form-text text-muted d-block">@L["Uncheck to save as draft"]</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["Create"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            tinymce.init({
                selector: '#tinymce-content',
                height: 500,
                menubar: true,
                plugins: [
                    'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                    'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                    'insertdatetime', 'media', 'table', 'help', 'wordcount'
                ],
                toolbar: 'undo redo | formatselect | bold italic backcolor | \
                         alignleft aligncenter alignright alignjustify | \
                         bullist numlist outdent indent | removeformat | help',
                content_style: 'body { font-family: Arial, sans-serif; font-size: 14px }',
                promotion: false,
                setup: function(editor) {
                    // Copy content to hidden input before form submit
                    editor.on('change', function() {
                        document.getElementById('ContentCs').value = editor.getContent();
                    });
                    editor.on('keyup', function() {
                        document.getElementById('ContentCs').value = editor.getContent();
                    });
                }
            });
            
            // Ensure content is copied on form submit
            document.querySelector('form').addEventListener('submit', function(e) {
                if (tinymce.activeEditor) {
                    document.getElementById('ContentCs').value = tinymce.activeEditor.getContent();
                }
            });
        });
    </script>
}
