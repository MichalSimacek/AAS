@page
@model PersonalDataModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-database"></i>
            @L["Personal Data"]
        </h2>
        <p class="settings-card-description">Download or delete your personal data stored in your account.</p>
    </div>
    
    <div class="info-box">
        <p>
            <i class="bi bi-info-circle-fill" style="color: #3B82F6; margin-right: 8px;"></i>
            @L["Personal data description"]
        </p>
    </div>
    
    <form method="post">
        <button class="btn-primary" type="submit" asp-page-handler="DownloadData">
            <i class="bi bi-download"></i>
            @L["Download data button"]
        </button>
    </form>
</div>

<div class="settings-card danger-zone">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-exclamation-triangle"></i>
            @L["Delete Account"]
        </h2>
        <p class="settings-card-description">Permanently delete your account and all associated data.</p>
    </div>
    
    <div class="info-box danger">
        <p>
            <i class="bi bi-exclamation-octagon-fill" style="margin-right: 8px;"></i>
            @L["Delete warning"]
        </p>
    </div>
    
    <form id="delete-user" method="post" asp-page-handler="DeleteAccount">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">@L["Confirm password label"]</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Enter your password to confirm deletion" type="password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        
        <button class="btn-danger" type="submit">
            <i class="bi bi-trash3"></i>
            @L["Delete account button"]
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
