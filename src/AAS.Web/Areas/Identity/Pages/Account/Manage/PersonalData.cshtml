@page
@model PersonalDataModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-database"></i>
            Personal Data
        </h2>
        <p class="settings-card-description">Download or manage your personal information.</p>
    </div>
    
    <div class="info-box">
        <p>
            <i class="bi bi-info-circle-fill" style="color: #3B82F6;"></i>
            Your account contains personal data that you have provided. You can download this data at any time.
        </p>
    </div>
    
    <form method="post">
        <button class="btn-primary" type="submit" asp-page-handler="DownloadData">
            <i class="bi bi-download"></i>
            Download My Data
        </button>
    </form>
</div>

<div class="settings-card danger-zone">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-exclamation-triangle"></i>
            Delete Account
        </h2>
        <p class="settings-card-description">Permanently remove your account and all data.</p>
    </div>
    
    <div class="info-box danger">
        <p>
            <i class="bi bi-exclamation-octagon-fill"></i>
            This action is permanent and cannot be undone. All your data will be deleted forever.
        </p>
    </div>
    
    <form id="delete-user" method="post" asp-page-handler="DeleteAccount">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">Confirm with Password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Enter your password to confirm" type="password" style="border-color: #FCA5A5;" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        
        <button class="btn-danger" type="submit">
            <i class="bi bi-trash3-fill"></i>
            Delete Account Permanently
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
