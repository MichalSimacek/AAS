@page
@model ChangePasswordModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-shield-lock"></i>
            @L["Change Password"]
        </h2>
        <p class="settings-card-description">Ensure your account is using a strong password to stay secure.</p>
    </div>
    
    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <div class="form-group">
            <label asp-for="Input.OldPassword" class="form-label">@L["Current Password"]</label>
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@L["Current password placeholder"]" type="password" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
        
        <div class="form-group">
            <label asp-for="Input.NewPassword" class="form-label">@L["New Password"]</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["New password placeholder"]" type="password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            <span class="form-hint">
                <i class="bi bi-shield-check"></i>
                Password must be at least 12 characters long
            </span>
        </div>
        
        <div class="form-group">
            <label asp-for="Input.ConfirmPassword" class="form-label">@L["Confirm Password"]</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["Confirm password placeholder"]" type="password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        
        <div style="margin-top: 32px;">
            <button type="submit" class="btn-primary">
                <i class="bi bi-arrow-repeat"></i>
                @L["Update password"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
