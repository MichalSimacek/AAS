@page
@model ChangePasswordModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-shield-lock"></i>
            Change Password
        </h2>
        <p class="settings-card-description">Ensure your account is using a strong and secure password.</p>
    </div>
    
    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <div class="form-group">
            <label asp-for="Input.OldPassword" class="form-label">Current Password</label>
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your current password" type="password" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
        
        <div class="form-group">
            <label asp-for="Input.NewPassword" class="form-label">New Password</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Choose a strong password" type="password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            <span class="form-hint">
                <i class="bi bi-shield-check"></i>
                Must be at least 12 characters with mixed case and numbers
            </span>
        </div>
        
        <div class="form-group">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Re-enter your new password" type="password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        
        <div style="margin-top: 36px;">
            <button type="submit" class="btn-primary">
                <i class="bi bi-arrow-clockwise"></i>
                Update Password
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
