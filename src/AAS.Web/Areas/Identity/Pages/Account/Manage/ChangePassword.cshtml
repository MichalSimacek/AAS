@page
@model ChangePasswordModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="manage-content-wrapper">
    <div class="manage-sidebar">
        <partial name="_ManageNav" />
    </div>
    <div class="manage-main-content">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <div class="manage-card">
            <h4 class="manage-card-title">
                <i class="bi bi-key-fill" style="color: #B8941F; margin-right: 12px; font-size: 28px; vertical-align: middle;"></i>
                @L["Change Password"]
            </h4>
            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>
                
                <div class="mb-4">
                    <label asp-for="Input.OldPassword" class="form-label">
                        <i class="bi bi-lock-fill" style="color: #B8941F;"></i>
                        @L["Current Password"]
                    </label>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@L["Current password placeholder"]" type="password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Input.NewPassword" class="form-label">
                        <i class="bi bi-shield-lock-fill" style="color: #B8941F;"></i>
                        @L["New Password"]
                    </label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["New password placeholder"]" type="password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        Password must be at least 12 characters long
                    </small>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">
                        <i class="bi bi-check-circle-fill" style="color: #B8941F;"></i>
                        @L["Confirm Password"]
                    </label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["Confirm password placeholder"]" type="password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                
                <div style="margin-top: 32px;">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-arrow-repeat me-2"></i>
                        @L["Update password"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
