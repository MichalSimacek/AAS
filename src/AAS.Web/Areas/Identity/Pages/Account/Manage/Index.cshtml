@page
@model IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-person-circle"></i>
            Profile Information
        </h2>
        <p class="settings-card-description">Update your personal details and contact information.</p>
    </div>
    
    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <div class="form-group">
            <label asp-for="Username" class="form-label">Email / Username</label>
            <input asp-for="Username" class="form-control" placeholder="your.email@example.com" disabled />
            <span class="form-hint">
                <i class="bi bi-lock-fill"></i>
                This is your login email and cannot be changed
            </span>
        </div>
        
        <div class="form-group">
            <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            <span class="form-hint">
                <i class="bi bi-info-circle"></i>
                Optional - Used for account recovery
            </span>
        </div>
        
        <div style="margin-top: 36px;">
            <button id="update-profile-button" type="submit" class="btn-primary">
                <i class="bi bi-check-circle-fill"></i>
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
