@page
@model IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="manage-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="manage-content-wrapper">
    <div class="manage-sidebar">
        <partial name="_ManageNav" />
    </div>
    <div class="manage-main-content">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <div class="manage-card">
            <h4 class="manage-card-title">
                <i class="bi bi-person-circle" style="color: #B8941F; margin-right: 12px; font-size: 28px; vertical-align: middle;"></i>
                @L["Profile Information"]
            </h4>
            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>
                
                <div class="mb-4">
                    <label asp-for="Username" class="form-label">
                        <i class="bi bi-envelope-fill" style="color: #B8941F;"></i>
                        @L["Email / Username"]
                    </label>
                    <input asp-for="Username" class="form-control" placeholder="@L["Email label placeholder"]" disabled />
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        This email is used for login and cannot be changed here
                    </small>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Input.PhoneNumber" class="form-label">
                        <i class="bi bi-telephone-fill" style="color: #B8941F;"></i>
                        @L["Phone number"]
                    </label>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="@L["Phone placeholder"]" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    <small class="text-muted">
                        <i class="bi bi-shield-check"></i>
                        Optional - Used for account recovery
                    </small>
                </div>
                
                <div style="margin-top: 32px;">
                    <button id="update-profile-button" type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>
                        @L["Save changes"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
