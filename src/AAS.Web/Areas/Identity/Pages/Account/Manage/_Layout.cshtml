@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="account-settings-container">
    <div class="container">
        <div class="settings-wrapper">
            <!-- Sidebar Navigation -->
            <aside class="settings-sidebar">
                <div class="sidebar-header">
                    <h2>Settings</h2>
                    <p>Manage your account</p>
                </div>
                
                <nav class="sidebar-nav">
                    <a href="/Identity/Account/Manage" class="nav-item active" data-section="profile">
                        <div class="nav-icon">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="nav-content">
                            <span class="nav-title">Profile</span>
                            <span class="nav-desc">Personal information</span>
                        </div>
                    </a>
                    
                    <a href="/Identity/Account/Manage/ChangePassword" class="nav-item" data-section="security">
                        <div class="nav-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div class="nav-content">
                            <span class="nav-title">Security</span>
                            <span class="nav-desc">Password & authentication</span>
                        </div>
                    </a>
                    
                    <a href="/Identity/Account/Manage/Email" class="nav-item" data-section="email">
                        <div class="nav-icon">
                            <i class="bi bi-envelope-at"></i>
                        </div>
                        <div class="nav-content">
                            <span class="nav-title">Email</span>
                            <span class="nav-desc">Email preferences</span>
                        </div>
                    </a>
                    
                    <a href="/Identity/Account/Manage/PersonalData" class="nav-item" data-section="privacy">
                        <div class="nav-icon">
                            <i class="bi bi-database-lock"></i>
                        </div>
                        <div class="nav-content">
                            <span class="nav-title">Privacy</span>
                            <span class="nav-desc">Data & account deletion</span>
                        </div>
                    </a>
                </nav>
            </aside>
            
            <!-- Main Content Area -->
            <main class="settings-content" id="settings-main-content">
                @RenderBody()
            </main>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Only select nav items within settings sidebar
    const sidebar = document.querySelector('.settings-sidebar');
    if (!sidebar) return; // Exit if sidebar doesn't exist
    
    const navItems = sidebar.querySelectorAll('.nav-item');
    const contentArea = document.getElementById('settings-main-content');
    
    if (!contentArea || navItems.length === 0) return;
    
    // Map sections to URLs
    const sectionUrls = {
        'profile': '/Identity/Account/Manage',
        'security': '/Identity/Account/Manage/ChangePassword',
        'email': '/Identity/Account/Manage/Email',
        'privacy': '/Identity/Account/Manage/PersonalData'
    };
    
    // Set active nav based on current URL
    const currentPath = window.location.pathname;
    navItems.forEach(item => {
        const section = item.dataset.section;
        const targetUrl = sectionUrls[section];
        
        if (targetUrl && currentPath.includes(targetUrl)) {
            navItems.forEach(i => i.classList.remove('active'));
            item.classList.add('active');
        }
    });
    
    // Add click handlers only to sidebar nav items
    navItems.forEach(item => {
        item.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation(); // Prevent event bubbling
            
            const section = this.dataset.section;
            const url = sectionUrls[section];
            
            // Safety check
            if (!url) {
                console.error('No URL found for section:', section);
                return;
            }
            
            // Don't reload if already on this page
            if (window.location.pathname === url) {
                return;
            }
            
            // Update active state
            navItems.forEach(i => i.classList.remove('active'));
            this.classList.add('active');
            
            // Fade out current content
            contentArea.style.opacity = '0';
            contentArea.style.transform = 'translateX(20px)';
            contentArea.style.transition = 'all 0.2s ease';
            
            // Load new content after fade
            setTimeout(() => {
                window.location.href = url;
            }, 200);
        });
    });
});
</script>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
