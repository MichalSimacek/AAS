@page
@model EmailModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-envelope-at"></i>
            @L["Manage Email"]
        </h2>
        <p class="settings-card-description">Update your email address and verification status.</p>
    </div>
    
    <form id="email-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <div class="form-group">
            <label asp-for="Email" class="form-label">@L["Current Email"]</label>
            <input asp-for="Email" class="form-control" placeholder="@L["Email label placeholder"]" disabled />
            
            @if (Model.IsEmailConfirmed)
            {
                <div class="status-indicator verified">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@L["Email confirmed"]</span>
                </div>
            }
            else
            {
                <div class="status-indicator unverified">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@L["Email not confirmed"]</span>
                </div>
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn-link" style="margin-top: 8px; padding: 4px 8px;">
                    <i class="bi bi-send-fill"></i>
                    @L["Send verification email"]
                </button>
            }
        </div>
        
        <div class="form-group">
            <label asp-for="Input.NewEmail" class="form-label">@L["New email"]</label>
            <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="@L["New email placeholder"]" type="email" />
            <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            <span class="form-hint">
                <i class="bi bi-info-circle"></i>
                A confirmation email will be sent to verify the new address
            </span>
        </div>
        
        <div style="margin-top: 32px;">
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-primary">
                <i class="bi bi-arrow-right-circle"></i>
                @L["Change email"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
