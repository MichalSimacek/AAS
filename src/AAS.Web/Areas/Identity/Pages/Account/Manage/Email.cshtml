@page
@model EmailModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Account Settings"];
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="settings-card">
    <div class="settings-card-header">
        <h2 class="settings-card-title">
            <i class="bi bi-envelope-at"></i>
            Email Settings
        </h2>
        <p class="settings-card-description">Manage your email address and verification status.</p>
    </div>
    
    <form id="email-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <div class="form-group">
            <label asp-for="Email" class="form-label">Current Email</label>
            <input asp-for="Email" class="form-control" placeholder="your.email@example.com" disabled />
            
            @if (Model.IsEmailConfirmed)
            {
                <div class="status-indicator verified">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Email Verified</span>
                </div>
            }
            else
            {
                <div class="status-indicator unverified">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Email Not Verified</span>
                </div>
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn-link" style="margin-top: 12px;">
                    <i class="bi bi-send-fill"></i>
                    Send Verification Email
                </button>
            }
        </div>
        
        <div class="form-group">
            <label asp-for="Input.NewEmail" class="form-label">New Email Address</label>
            <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="new.email@example.com" type="email" />
            <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            <span class="form-hint">
                <i class="bi bi-info-circle"></i>
                A confirmation link will be sent to verify your new email
            </span>
        </div>
        
        <div style="margin-top: 36px;">
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-primary">
                <i class="bi bi-arrow-right-circle-fill"></i>
                Update Email
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
